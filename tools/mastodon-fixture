  do
    case "$port" in
      ''|*[!0-9]*) die "invalid differential published port: $port" ;;
    esac
  done

  mastodon_database_url="postgresql://$DIFFERENTIAL_READER:$DIFFERENTIAL_READER_PASSWORD@127.0.0.1:$database_port/$mastodon_database"
  rust_database_url="postgresql://$DIFFERENTIAL_READER:$DIFFERENTIAL_READER_PASSWORD@127.0.0.1:$database_port/$rust_database"
  mastodon_owner_database_url="postgresql://$DATABASE_USER:$DATABASE_PASSWORD@127.0.0.1:$database_port/$mastodon_database"
  rust_write_database_url="postgresql://$DIFFERENTIAL_WRITER:$DIFFERENTIAL_WRITER_PASSWORD@127.0.0.1:$database_port/$rust_database"
  if [ -n "$case_name" ]; then
    RUSTODON_DIFFERENTIAL_RUN_ID="$DIFFERENTIAL_RUN_ID" \
      RUSTODON_DIFFERENTIAL_PAPERCLIP_ROOT_URL="$differential_paperclip_root_url" \
      RUSTODON_DIFFERENTIAL_MASTODON_HTTP_URL="http://127.0.0.1:$web_port" \
       RUSTODON_DIFFERENTIAL_MASTODON_DATABASE_URL="$mastodon_database_url" \
       RUSTODON_DIFFERENTIAL_MASTODON_OWNER_DATABASE_URL="$mastodon_owner_database_url" \
       RUSTODON_DIFFERENTIAL_RUST_DATABASE_URL="$rust_database_url" \
       RUSTODON_DIFFERENTIAL_RUST_OWNER_DATABASE_URL="$rust_owner_url" \
       RUSTODON_DIFFERENTIAL_RUST_WRITE_DATABASE_URL="$rust_write_database_url" \
      with_differential_test_profile "$case_name" \
        cargo test --locked --features test-support --test differential "$case_name" -- --ignored --exact --nocapture --test-threads=1
  else
    RUSTODON_DIFFERENTIAL_RUN_ID="$DIFFERENTIAL_RUN_ID" \
      RUSTODON_DIFFERENTIAL_PAPERCLIP_ROOT_URL='/system' \
      RUSTODON_DIFFERENTIAL_MASTODON_HTTP_URL="http://127.0.0.1:$web_port" \
       RUSTODON_DIFFERENTIAL_MASTODON_DATABASE_URL="$mastodon_database_url" \
       RUSTODON_DIFFERENTIAL_MASTODON_OWNER_DATABASE_URL="$mastodon_owner_database_url" \
       RUSTODON_DIFFERENTIAL_RUST_DATABASE_URL="$rust_database_url" \
      RUSTODON_DIFFERENTIAL_RUST_OWNER_DATABASE_URL="$rust_owner_url" \
      RUSTODON_DIFFERENTIAL_RUST_WRITE_DATABASE_URL="$rust_write_database_url" \
      cargo test --locked --features test-support --test differential -- --ignored --nocapture --test-threads=1 \
        --skip notification_writes --skip status_authorization_matrix --skip mixed_profile_media

    reset_differential_feeds "$mastodon_database" "$mastodon_media" "$media_mode"
    published_web=$(run_podman port "$WEB_CONTAINER" 3000/tcp)
    web_port=${published_web##*:}
    RUSTODON_DIFFERENTIAL_RUN_ID="$DIFFERENTIAL_RUN_ID" \
      RUSTODON_DIFFERENTIAL_MASTODON_HTTP_URL="http://127.0.0.1:$web_port" \
       RUSTODON_DIFFERENTIAL_MASTODON_DATABASE_URL="$mastodon_database_url" \
       RUSTODON_DIFFERENTIAL_MASTODON_OWNER_DATABASE_URL="$mastodon_owner_database_url" \
       RUSTODON_DIFFERENTIAL_RUST_DATABASE_URL="$rust_database_url" \
       RUSTODON_DIFFERENTIAL_RUST_OWNER_DATABASE_URL="$rust_owner_url" \
       RUSTODON_DIFFERENTIAL_RUST_WRITE_DATABASE_URL="$rust_write_database_url" \
      cargo test --locked --test differential notification_writes \
        -- --ignored --exact --nocapture --test-threads=1

    reset_differential_feeds "$mastodon_database" "$mastodon_media" "$media_mode"
    published_web=$(run_podman port "$WEB_CONTAINER" 3000/tcp)
    web_port=${published_web##*:}
    RUSTODON_DIFFERENTIAL_RUN_ID="$DIFFERENTIAL_RUN_ID" \
      RUSTODON_DIFFERENTIAL_MASTODON_HTTP_URL="http://127.0.0.1:$web_port" \
       RUSTODON_DIFFERENTIAL_MASTODON_DATABASE_URL="$mastodon_database_url" \
       RUSTODON_DIFFERENTIAL_MASTODON_OWNER_DATABASE_URL="$mastodon_owner_database_url" \
       RUSTODON_DIFFERENTIAL_RUST_DATABASE_URL="$rust_database_url" \
       RUSTODON_DIFFERENTIAL_RUST_OWNER_DATABASE_URL="$rust_owner_url" \
       RUSTODON_DIFFERENTIAL_RUST_WRITE_DATABASE_URL="$rust_write_database_url" \
      cargo test --locked --test differential status_authorization_matrix \
        -- --ignored --exact --nocapture --test-threads=1

    reset_differential_feeds "$mastodon_database" "$mastodon_media" "$media_mode" \
      'https://media.fixture.invalid/system'
    published_web=$(run_podman port "$WEB_CONTAINER" 3000/tcp)
    web_port=${published_web##*:}
    RUSTODON_DIFFERENTIAL_RUN_ID="$DIFFERENTIAL_RUN_ID" \
      RUSTODON_DIFFERENTIAL_PAPERCLIP_ROOT_URL='https://media.fixture.invalid/system' \
      RUSTODON_DIFFERENTIAL_MASTODON_HTTP_URL="http://127.0.0.1:$web_port" \
      RUSTODON_DIFFERENTIAL_MASTODON_DATABASE_URL="$mastodon_database_url" \
      RUSTODON_DIFFERENTIAL_MASTODON_OWNER_DATABASE_URL="$mastodon_owner_database_url" \
      RUSTODON_DIFFERENTIAL_RUST_DATABASE_URL="$rust_database_url" \
      RUSTODON_DIFFERENTIAL_RUST_OWNER_DATABASE_URL="$rust_owner_url" \
      RUSTODON_DIFFERENTIAL_RUST_WRITE_DATABASE_URL="$rust_write_database_url" \
      cargo test --locked --test differential actor_media_root_url \
        -- --ignored --exact --nocapture --test-threads=1

    # Run once after comparisons on shared seeded accounts, not in the debug batch.
    RUSTODON_DIFFERENTIAL_RUN_ID="$DIFFERENTIAL_RUN_ID" \
      RUSTODON_DIFFERENTIAL_PAPERCLIP_ROOT_URL='/system' \
      RUSTODON_DIFFERENTIAL_MASTODON_HTTP_URL="http://127.0.0.1:$web_port" \
      RUSTODON_DIFFERENTIAL_MASTODON_DATABASE_URL="$mastodon_database_url" \
      RUSTODON_DIFFERENTIAL_MASTODON_OWNER_DATABASE_URL="$mastodon_owner_database_url" \
      RUSTODON_DIFFERENTIAL_RUST_DATABASE_URL="$rust_database_url" \
      RUSTODON_DIFFERENTIAL_RUST_OWNER_DATABASE_URL="$rust_owner_url" \
      RUSTODON_DIFFERENTIAL_RUST_WRITE_DATABASE_URL="$rust_write_database_url" \
      with_differential_test_profile mixed_profile_media \
        cargo test --locked --features test-support --test differential mixed_profile_media \
          -- --ignored --exact --nocapture --test-threads=1
  fi

  finish_differential
  printf 'differential compatibility case(s) passed against Mastodon %s\n' "$RELEASE"
}

reproducibility_check() {
  verify_static "$FIXTURE_DIR"
  candidate="$ROOT/target/mastodon-v4.6.5-repro-$$"
  generate_fixture "$candidate"
  verify_static "$candidate"
  if ! diff -r "$FIXTURE_DIR" "$candidate" >/dev/null; then
    die "byte-for-byte reproducibility mismatch; inspect $candidate"
  fi
  rm -rf "$candidate"
  printf 'byte-for-byte reproducibility check passed for Mastodon %s\n' "$RELEASE"
}

usage() {
  cat <<'EOF'
Usage: tools/mastodon-fixture COMMAND [PATH]

Commands:
  safety                 Print the hard-coded fixture database and domains
  obtain [PATH]          Obtain and verify the pinned Mastodon source
  verify-source PATH     Verify source tag, revision, schema version, and hash
  generate [PATH]        Generate artifacts (default: checked fixture path)
  verify [PATH]          Verify pinned metadata and artifact checksums (fast)
  restore-verify [PATH]  Restore and verify with PostgreSQL and Mastodon Rails
  schema-read-test       Run ignored Rust reads through a least-privilege role
  operational-schema-test
                           Verify isolated, idempotent Rustodon schema creation
  worker-test              Exercise durable jobs and worker process lifecycle
  startup-test             Prove web and worker fail closed before readiness
  preflight-test         Run canonical and rejection preflight cases
  cutover-test            Rehearse cutover, smoke checks, rollback, and Mastodon reopen
  differential-test [CASE]
                          Run all or one Rails-versus-Rust compatibility case
  repro                   Regenerate and compare every fixture byte
EOF
}

# Sibling harnesses reuse pinned images and task-owned database lifecycle only.
if [ "${MASTODON_FIXTURE_LIBRARY:-0}" = 1 ]; then
  return 0
fi

command=${1:-}
if [ -n "$command" ]; then
  shift
fi

case "$command" in
  safety)
    [ "$#" -eq 0 ] || die 'safety takes no arguments'
    printf 'database=%s\ndomain=%s\nremote_domain=%s\n' "$DATABASE_NAME" "$LOCAL_DOMAIN" "$REMOTE_DOMAIN"
    ;;
  obtain)
    [ "$#" -le 1 ] || die 'obtain accepts at most one path'
    obtain_source "${1:-$SOURCE_DIR}"
    ;;
  verify-source)
    [ "$#" -eq 1 ] || die 'verify-source requires exactly one path'
    verify_source "$1"
    ;;
  generate)
    [ "$#" -le 1 ] || die 'refusing unsupported fixture destination or override'
    generate_fixture "${1:-$FIXTURE_DIR}"
    ;;
  verify)
    [ "$#" -le 1 ] || die 'verify accepts at most one path'
    verify_static "${1:-$FIXTURE_DIR}"
    ;;
  restore-verify)
    [ "$#" -le 1 ] || die 'restore-verify accepts at most one path'
    restore_verify "${1:-$FIXTURE_DIR}"
    ;;
  schema-read-test)
    [ "$#" -le 1 ] || die 'schema-read-test accepts at most one named case'
    case "${1:-}" in
      '')
        for selector in mastodon_schema account_stats_repair saved_status_authorization qualified_local_mentions followed_hashtag_streams public_oauth_revocation oauth_response_modes v2_account_search api_empty_reads web_settings media_proxy media_state batch_accounts; do
          schema_read_test "$FIXTURE_DIR" "$selector"
        done
        ;;
      mastodon_schema|account_stats_repair|saved_status_authorization|qualified_local_mentions|followed_hashtag_streams|public_oauth_revocation|oauth_response_modes|v2_account_search|api_empty_reads|web_settings|media_proxy|media_state|batch_accounts)
        schema_read_test "$FIXTURE_DIR" "$1"
        ;;
      *) die "unknown schema-read test: $1" ;;
    esac
    ;;
  operational-schema-test)
    [ "$#" -eq 0 ] || die 'operational-schema-test takes no arguments'
    operational_schema_test
    ;;
  worker-test)
    [ "$#" -eq 0 ] || die 'worker-test takes no arguments'
    worker_test
    ;;
  startup-test)
    [ "$#" -eq 0 ] || die 'startup-test takes no arguments'
    startup_test
    ;;
  preflight-test)
    [ "$#" -eq 0 ] || die 'preflight-test takes no arguments'
    preflight_test
    ;;
  cutover-test)
    [ "$#" -eq 0 ] || die 'cutover-test takes no arguments'
    cutover_test
    ;;
  differential-test)
    [ "$#" -le 1 ] || die 'differential-test accepts at most one case'
    differential_test "${1:-}"
    ;;
  repro)
    [ "$#" -eq 0 ] || die 'repro takes no arguments'
    reproducibility_check
    ;;
  help|-h|--help)
    usage
    ;;
  '')
    usage >&2
    exit 2
    ;;
  *)
    usage >&2
    die "unknown command: $command"
    ;;
esac
