CREATE DATABASE $receiver_database TEMPLATE $DATABASE_NAME;
REVOKE ALL ON DATABASE $receiver_database FROM PUBLIC;
GRANT CONNECT ON DATABASE $receiver_database TO $WORKER_RUNTIME;
EOF
  RUSTODON_WORKER_RECEIVER_DATABASE_URL="postgresql://$WORKER_RUNTIME:$WORKER_RUNTIME_PASSWORD@127.0.0.1:$published_port/$receiver_database" \
  RUSTODON_WORKER_RECEIVER_OWNER_DATABASE_URL="postgresql://$DATABASE_USER:$DATABASE_PASSWORD@127.0.0.1:$published_port/$receiver_database" \
  RUSTODON_WORKER_DATABASE_URL="$runtime_url" \
  RUSTODON_WORKER_ADMIN_DATABASE_URL="$migrator_url" \
  RUSTODON_WORKER_WRITE_DATABASE_URL="$writer_url" \
  RUSTODON_WORKER_OWNER_DATABASE_URL="postgresql://$DATABASE_USER:$DATABASE_PASSWORD@127.0.0.1:$published_port/$DATABASE_NAME" \
    cargo test --locked --features test-support --test workers -- --ignored --nocapture --test-threads=1

  start_worker_cli "$runtime_url" "$worker_log" "$writer_url" &
  worker_pid=$!
  ready=false
  for _ in $(seq 1 60); do
    if run_worker_cli "$runtime_url" admin worker-readiness >/dev/null 2>&1
    then
      ready=true
      break
    fi
    sleep 0.1
  done
  if [ "$ready" != true ]; then
    kill -TERM "$worker_pid" >/dev/null 2>&1 || true
    wait "$worker_pid" >/dev/null 2>&1 || true
    die "worker did not become ready; inspect $worker_log"
  fi
  run_worker_cli "$runtime_url" admin dead-jobs --limit 10 >/dev/null
  kill -TERM "$worker_pid"
  wait "$worker_pid" || die "worker did not stop successfully; inspect $worker_log"
  remaining_heartbeats=$(run_podman exec "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --tuples-only --no-align \
    --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    --command "SELECT count(*) FROM rustodon.heartbeats")
  [ "$remaining_heartbeats" = '0' ] || die 'worker left stale heartbeats after shutdown'
  rm "$worker_log"
  finish_database
  printf 'durable worker integration passed for Mastodon %s\n' "$RELEASE"
}

