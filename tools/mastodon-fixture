start_differential_redis() {
  publish=${1:-false}
  REDIS_CONTAINER="rustodon-differential-v4-6-5-redis-$$"
  publish_arguments=''
  if [ "$publish" = 'publish' ]; then
    publish_arguments='--publish 127.0.0.1::6379'
  elif [ "$publish" != 'false' ]; then
    die "unknown Redis publication mode: $publish"
  fi
  run_podman run -d \
    --platform "$PLATFORM" \
    --name "$REDIS_CONTAINER" \
    --label 'io.rustodon.fixture=mastodon-v4.6.5' \
    --label "io.rustodon.fixture.session=$$" \
    --network "$NETWORK" \
    $publish_arguments \
    --tmpfs /data:rw,nosuid,nodev,noexec,size=64m \
    "$REDIS_IMAGE" redis-server --save '' --appendonly no >/dev/null

  attempts=0
  until [ "$(run_podman exec "$REDIS_CONTAINER" redis-cli ping 2>/dev/null || true)" = 'PONG' ]
  do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 60 ]; then
      die 'Redis differential container did not become ready'
    fi
    sleep 1
  done
}

