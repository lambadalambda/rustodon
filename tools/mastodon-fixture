  # schema change performed by Rustodon. Provision it before the baseline so
  # the final catalog comparison covers the idempotent cutover sequence.
  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
