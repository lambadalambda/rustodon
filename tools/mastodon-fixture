die() {
  printf 'mastodon-fixture: %s\n' "$*" >&2
  exit 1
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

# Deliberately pass only process/runtime variables needed by rootless Podman.
# Database, domain, and Rails secret values are constants below, never inherited.
run_podman() {
  env -i \
    PATH="$PATH" \
    HOME="${HOME:-/tmp}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
    podman "$@"
}

cleanup_containers() {
  if [ -n "$WEB_CONTAINER" ]; then
    run_podman rm -f --volumes "$WEB_CONTAINER" >/dev/null 2>&1 || true
    WEB_CONTAINER=''
  fi
  if [ -n "$REDIS_CONTAINER" ]; then
    run_podman rm -f --volumes "$REDIS_CONTAINER" >/dev/null 2>&1 || true
    REDIS_CONTAINER=''
  fi
  if [ -n "$PG_CONTAINER" ]; then
    run_podman rm -f --volumes "$PG_CONTAINER" >/dev/null 2>&1 || true
    PG_CONTAINER=''
  fi
  if [ -n "$PG_VOLUME" ]; then
    run_podman volume rm -f "$PG_VOLUME" >/dev/null 2>&1 || true
    PG_VOLUME=''
  fi
  if [ -n "$NETWORK" ]; then
    run_podman network rm "$NETWORK" >/dev/null 2>&1 || true
    NETWORK=''
  fi
  if [ -n "$DIFFERENTIAL_ROOT" ]; then
    expected_root="$ROOT/target/differential-$DIFFERENTIAL_RUN_ID"
    marker="$DIFFERENTIAL_ROOT/.rustodon-differential-run"
    if [ "$DIFFERENTIAL_ROOT" = "$expected_root" ] &&
       [ -f "$marker" ] &&
       [ "$(cat "$marker")" = "run=$DIFFERENTIAL_RUN_ID" ]
    then
      rm -rf "$DIFFERENTIAL_ROOT" || true
      if [ -e "$DIFFERENTIAL_ROOT" ]; then
        run_podman unshare rm -rf "$DIFFERENTIAL_ROOT" >/dev/null 2>&1 || true
      fi
    fi
    DIFFERENTIAL_ROOT=''
  fi
}

finish_database() {
  finished_volume=$PG_VOLUME
  cleanup_containers
  trap - EXIT HUP INT TERM
  if run_podman volume exists "$finished_volume"; then
    die "fixture PostgreSQL volume leaked after cleanup: $finished_volume"
  fi
}

verify_image() {
  image_label=$1
  index_image=$2
  manifest_digest=$3
  child_image=$4

  # Immutable child pins can be verified locally; repeated registry index requests
  # needlessly make cached, disposable tests depend on pull quotas and connectivity.
  if inspected=$(run_podman image inspect "$child_image" --format '{{.Os}}/{{.Architecture}}|{{.Digest}}' 2>/dev/null); then
    [ "$inspected" = "$PLATFORM|$manifest_digest" ] ||
      die "$image_label cached child mismatch: expected $PLATFORM|$manifest_digest, got $inspected"
    return
  fi

  manifest=$(run_podman manifest inspect "$index_image")
  printf '%s\n' "$manifest" | grep -F "\"digest\": \"$manifest_digest\"" >/dev/null 2>&1 ||
    die "$image_label index does not contain pinned linux/amd64 child $manifest_digest"
  run_podman pull --quiet --platform "$PLATFORM" "$child_image" >/dev/null
  inspected=$(run_podman image inspect "$child_image" --format '{{.Os}}/{{.Architecture}}|{{.Digest}}')
  if [ "$inspected" != "$PLATFORM|$manifest_digest" ]; then
    die "$image_label child mismatch: expected $PLATFORM|$manifest_digest, got $inspected"
  fi
}

verify_images() {
  verify_image Mastodon "$MASTODON_INDEX_IMAGE" "$MASTODON_MANIFEST_DIGEST" "$MASTODON_IMAGE"
  verify_image PostgreSQL "$POSTGRES_INDEX_IMAGE" "$POSTGRES_MANIFEST_DIGEST" "$POSTGRES_IMAGE"
}

verify_differential_images() {
