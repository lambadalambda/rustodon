start_database() {
  publish=${1:-false}
  cleanup_mode=${2:-fixture}
  need_command podman
  NETWORK="rustodon-fixture-v4-6-5-network-$$"
  PG_CONTAINER="rustodon-fixture-v4-6-5-postgres-$$"
  PG_VOLUME="rustodon-fixture-v4-6-5-postgres-$$"
  case "$cleanup_mode" in
    fixture)
      trap cleanup_containers EXIT HUP INT TERM
      ;;
    differential)
      trap differential_exit_cleanup EXIT
      trap 'exit 129' HUP
      trap 'exit 130' INT
      trap 'exit 143' TERM
      ;;
    *) die "unknown database cleanup mode: $cleanup_mode" ;;
  esac

  run_podman network create "$NETWORK" >/dev/null
  run_podman volume create \
    --label 'io.rustodon.fixture=mastodon-v4.6.5' \
    --label "io.rustodon.fixture.session=$$" \
    "$PG_VOLUME" >/dev/null
  publish_arguments=''
  if [ "$publish" = 'publish' ]; then
    publish_arguments='--publish 127.0.0.1::5432'
  elif [ "$publish" != 'false' ]; then
    die "unknown database publication mode: $publish"
  fi

  run_podman run -d \
    --platform "$PLATFORM" \
    --name "$PG_CONTAINER" \
    --label 'io.rustodon.fixture=mastodon-v4.6.5' \
    --network "$NETWORK" \
    --volume "$PG_VOLUME:/var/lib/postgresql/data" \
    $publish_arguments \
    --env "POSTGRES_DB=$DATABASE_NAME" \
    --env "POSTGRES_USER=$DATABASE_USER" \
    --env "POSTGRES_PASSWORD=$DATABASE_PASSWORD" \
    "$POSTGRES_IMAGE" >/dev/null

  attempts=0
  consecutive_ready_checks=0
  while [ "$consecutive_ready_checks" -lt 2 ]
  do
    if run_podman exec "$PG_CONTAINER" psql \
      --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
      --tuples-only --no-align --command 'SELECT 1' >/dev/null 2>&1
    then
      consecutive_ready_checks=$((consecutive_ready_checks + 1))
    else
      consecutive_ready_checks=0
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 60 ]; then
      die 'PostgreSQL fixture container did not become ready'
    fi
    sleep 1
  done
}

