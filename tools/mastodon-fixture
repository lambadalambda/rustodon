  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname postgres >/dev/null <<EOF
REVOKE ALL ON DATABASE $database FROM $DIFFERENTIAL_WRITER;
GRANT CONNECT ON DATABASE $database TO $DIFFERENTIAL_WRITER;
EOF

  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname "$database" >/dev/null <<EOF
CREATE OR REPLACE FUNCTION public.rustodon_refresh_instances()
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS \$\$
BEGIN
  REFRESH MATERIALIZED VIEW CONCURRENTLY public.instances;
END
\$\$;
REVOKE ALL ON FUNCTION public.rustodon_refresh_instances() FROM PUBLIC;
REVOKE EXECUTE ON FUNCTION public.timestamp_id(text) FROM PUBLIC;
REVOKE ALL ON SCHEMA public FROM $DIFFERENTIAL_WRITER;
GRANT USAGE ON SCHEMA public TO $DIFFERENTIAL_WRITER;
REVOKE ALL ON ALL TABLES IN SCHEMA public FROM $DIFFERENTIAL_WRITER;
GRANT SELECT ON TABLE
  public.account_aliases, public.account_deletion_requests,
  public.account_relationship_severance_events, public.account_stats,
  public.account_migrations, public.account_notes, public.account_pins,
  public.account_warnings,
  public.account_conversations,
  public.account_domain_blocks, public.accounts, public.blocks,
    public.canonical_email_blocks, public.domain_allows, public.domain_blocks,
   public.collection_items, public.collection_reports, public.collections, public.conversation_mutes,
      public.conversations, public.custom_emojis,
