file_sha256() {
  sha256sum "$1" | cut -d ' ' -f 1
}

file_bytes() {
  wc -c < "$1" | tr -d ' '
}

verify_source() {
  source_path=$1
  inside_work_tree=$(git -C "$source_path" rev-parse --is-inside-work-tree 2>/dev/null || true)
  if [ "$inside_work_tree" != 'true' ]; then
    die "Mastodon source revision mismatch: expected $REVISION, got not-a-git-checkout"
  fi

  dirty_paths=$(git -C "$source_path" status --porcelain --untracked-files=all)
  if [ -n "$dirty_paths" ]; then
    die "Mastodon source checkout is dirty; generation requires an exact pinned tree"
  fi

  actual_revision=$(git -C "$source_path" rev-parse HEAD 2>/dev/null || true)
  if [ "$actual_revision" != "$REVISION" ]; then
    die "Mastodon source revision mismatch: expected $REVISION, got ${actual_revision:-not-a-git-checkout}"
  fi

  actual_tag=$(git -C "$source_path" describe --tags --exact-match 2>/dev/null || true)
  if [ "$actual_tag" != "$RELEASE" ]; then
    die "Mastodon source tag mismatch: expected $RELEASE, got ${actual_tag:-no-exact-tag}"
  fi

  [ -f "$source_path/db/schema.rb" ] || die "Mastodon schema is missing from $source_path"
  actual_schema_sha256=$(git -C "$source_path" show "$REVISION:db/schema.rb" | sha256sum | cut -d ' ' -f 1)
  if [ "$actual_schema_sha256" != "$SCHEMA_SHA256" ]; then
    die "Mastodon schema SHA-256 mismatch: expected $SCHEMA_SHA256, got $actual_schema_sha256"
  fi

  schema_version=$(git -C "$source_path" show "$REVISION:db/schema.rb" | sed -n 's/.*define(version: \([0-9_]*\)).*/\1/p' | tr -d '_')
  if [ "$schema_version" != "$SCHEMA_VERSION" ]; then
    die "Mastodon schema version mismatch: expected $SCHEMA_VERSION, got ${schema_version:-unknown}"
  fi

  printf 'verified Mastodon %s source at %s\n' "$RELEASE" "$REVISION"
}

obtain_source() {
  destination=${1:-$SOURCE_DIR}
  case "$destination" in
    "$SOURCE_DIR") ;;
    "$ROOT"/target/mastodon-v4.6.5-*) ;;
    *) die 'refusing source destination outside the ignored target fixture paths' ;;
  esac

  need_command git
  if [ -e "$destination" ]; then
    verify_source "$destination"
    return
  fi

  parent=$(dirname "$destination")
  mkdir -p "$parent"
  git clone --filter=blob:none --branch "$RELEASE" --single-branch --depth 1 \
    https://github.com/mastodon/mastodon.git "$destination"
  verify_source "$destination"
}

write_migrations_manifest() {
  wm_source_path=$1
  wm_output=$2
  wm_versions=$3
  wm_records="$wm_output.records"

  printf 'version\tphase\tpath\tsha256\n' > "$wm_output"
  : > "$wm_records"
  git -C "$wm_source_path" ls-tree -r --name-only "$REVISION" -- db/migrate db/post_migrate |
    LC_ALL=C sort |
    while IFS= read -r path
    do
      case "$path" in
        *.rb) ;;
        *) continue ;;
      esac
      file_name=$(basename "$path")
      version=${file_name%%_*}
      case "$path" in
        db/migrate/*) phase='main' ;;
        db/post_migrate/*) phase='post' ;;
        *) die "unexpected migration path: $path" ;;
      esac
      checksum=$(git -C "$wm_source_path" show "$REVISION:$path" | sha256sum | cut -d ' ' -f 1)
      printf '%s\t%s\t%s\t%s\n' "$version" "$phase" "$path" "$checksum" >> "$wm_records"
    done
  LC_ALL=C sort -t "$(printf '\t')" -k1,1 -k2,2 -k3,3 "$wm_records" >> "$wm_output"
  cut -f 1 "$wm_records" | LC_ALL=C sort > "$wm_versions"
  rm "$wm_records"
}

