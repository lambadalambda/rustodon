dump_cutover_public_state() {
  prefix=$1
  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --tuples-only --no-align \
    --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    < "$FIXTURE_DIR/catalog-query.sql" > "${prefix}-catalog"
  run_podman exec --env LC_ALL=C "$PG_CONTAINER" pg_dump \
    --format=plain --encoding=UTF8 --no-owner --no-privileges --no-comments \
    --schema=public --schema-only --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    > "${prefix}-schema.raw"
  run_podman exec --env LC_ALL=C "$PG_CONTAINER" pg_dump \
    --format=plain --encoding=UTF8 --no-owner --no-privileges --no-comments \
    --schema=public --data-only --exclude-table-data=public.users \
    --exclude-table-data=public.oauth_access_tokens \
    --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    > "${prefix}-data.raw"
  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --tuples-only --no-align --field-separator "$(printf '\t')" \
    --username "$DATABASE_USER" --dbname "$DATABASE_NAME" > "${prefix}-auth" <<'SQL'
SELECT 'users', u.id::text,
       (to_jsonb(u) - ARRAY['current_sign_in_at', 'last_sign_in_at', 'updated_at'])::text
FROM public.users AS u
UNION ALL
SELECT 'oauth_access_tokens', t.id::text,
       (to_jsonb(t) - ARRAY['last_used_at', 'last_used_ip'])::text
FROM public.oauth_access_tokens AS t
ORDER BY 1, 2;
SQL
  sed -i \
    -e 's/^\\restrict .*/\\restrict rustodonCutoverTest/' \
    -e 's/^\\unrestrict .*/\\unrestrict rustodonCutoverTest/' \
    "${prefix}-schema.raw" "${prefix}-data.raw"
  mv "${prefix}-schema.raw" "${prefix}-schema"
  mv "${prefix}-data.raw" "${prefix}-data"
}

cutover_start_browser_tls() {
  command -v python3 >/dev/null 2>&1 || die 'browser fixture TLS requires python3'
  command -v openssl >/dev/null 2>&1 || die 'browser fixture TLS requires openssl'
  cutover_tls_dir=$(mktemp -d "$ROOT/target/cutover-browser-tls.XXXXXX")
  chmod 700 "$cutover_tls_dir"
  python3 "$ROOT/tools/browser-fixture-tls" --directory "$cutover_tls_dir" \
    --domain "$LOCAL_DOMAIN" --backend-port "$cutover_web_port" &
  cutover_tls_pid=$!
  cutover_tls_attempts=0
  until [ -f "$cutover_tls_dir/port" ]; do
    kill -0 "$cutover_tls_pid" 2>/dev/null || die 'browser fixture TLS exited before readiness'
    cutover_tls_attempts=$((cutover_tls_attempts + 1))
    [ "$cutover_tls_attempts" -lt 200 ] || die 'browser fixture TLS startup timed out'
    sleep 0.1
  done
  cutover_tls_port=$(cat "$cutover_tls_dir/port")
  case "$cutover_tls_port" in
    ''|*[!0-9]*) die 'invalid browser fixture TLS port' ;;
  esac
  [ "$cutover_tls_port" -ge 1 ] && [ "$cutover_tls_port" -le 65535 ] ||
    die 'invalid browser fixture TLS port'
  cutover_tls_spki=$(cat "$cutover_tls_dir/spki")
}

cutover_stop_browser_tls() {
  if [ -n "${cutover_tls_pid:-}" ]; then
    kill -TERM "$cutover_tls_pid" >/dev/null 2>&1 || true
    cutover_tls_attempts=0
    while kill -0 "$cutover_tls_pid" 2>/dev/null; do
      cutover_tls_attempts=$((cutover_tls_attempts + 1))
      [ "$cutover_tls_attempts" -lt 50 ] || break
      sleep 0.1
    done
    kill -KILL "$cutover_tls_pid" >/dev/null 2>&1 || true
    wait "$cutover_tls_pid" >/dev/null 2>&1 || true
    cutover_tls_pid=''
  fi
  # Certificates are never retained, even with CUTOVER_KEEP_ARTIFACTS=true.
  if [ -n "${cutover_tls_dir:-}" ]; then
    rm -rf -- "$cutover_tls_dir"
    cutover_tls_dir=''
  fi
  cutover_tls_port=''
  cutover_tls_spki=''
}

cutover_stop_processes() {
  cutover_stop_browser_tls
  if [ -n "${cutover_web_pid:-}" ]; then
    kill -TERM "$cutover_web_pid" >/dev/null 2>&1 || true
    wait "$cutover_web_pid" >/dev/null 2>&1 || true
    cutover_web_pid=''
  fi
  if [ -n "${cutover_worker_pid:-}" ]; then
    kill -TERM "$cutover_worker_pid" >/dev/null 2>&1 || true
    wait "$cutover_worker_pid" >/dev/null 2>&1 || true
    cutover_worker_pid=''
  fi
}

cutover_abort() {
  status=$?
  cutover_stop_processes
  cleanup_containers
  if [ -n "${cutover_browser_user_restore:-}" ]; then
    rm -f "$cutover_browser_user_restore"
  fi
  if [ -n "${cutover_browser_poll_status_file:-}" ]; then
    rm -f "$cutover_browser_poll_status_file"
  fi
  if [ "${CUTOVER_KEEP_ARTIFACTS:-false}" = true ]; then
    printf 'cutover artifacts retained under %s and %s\n' \
      "${cutover_worker_log:-}" "${cutover_web_log:-}" >&2
  else
    rm -rf "${cutover_before_media:-}" "${cutover_after_media:-}" \
      "${cutover_before_prefix:-}-catalog" "${cutover_before_prefix:-}-schema" \
      "${cutover_before_prefix:-}-data" "${cutover_before_prefix:-}-auth" \
      "${cutover_after_prefix:-}-catalog" "${cutover_after_prefix:-}-schema" \
      "${cutover_after_prefix:-}-data" "${cutover_after_prefix:-}-auth" \
      "${cutover_media_root:-}" \
      "${cutover_worker_log:-}" "${cutover_web_log:-}"
  fi
  trap - EXIT HUP INT TERM
  exit "$status"
}

wait_for_http() {
  url=$1
  attempts=0
  until curl --silent --show-error --fail --max-time 2 "$url" >/dev/null 2>&1
  do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 120 ]; then
      die "Rustodon did not become ready at $url"
    fi
    sleep 1
  done
}

cutover_preflight() {
  database_url=$1
  preflight_writer_url=${2:-}
  writer_environment=''
  if [ -n "$preflight_writer_url" ]; then
    writer_environment="WRITE_DATABASE_URL=$preflight_writer_url"
  fi
  if ! preflight_output=$(env -i \
    PATH="$PATH" HOME="${HOME:-/tmp}" \
    CARGO_HOME="${CARGO_HOME:-${HOME:-/tmp}/.cargo}" \
    RUSTUP_HOME="${RUSTUP_HOME:-${HOME:-/tmp}/.rustup}" \
