verify_podman_resource_absent() {
  resource_kind=$1
  resource_name=$2
  case "$resource_kind" in
    container) exists_command='container' ;;
    volume) exists_command='volume' ;;
    network) exists_command='network' ;;
    *) die "unknown Podman resource kind: $resource_kind" ;;
  esac

  if run_podman "$exists_command" exists "$resource_name" >/dev/null 2>&1; then
    printf 'mastodon-fixture: differential %s leaked after cleanup: %s\n' \
      "$resource_kind" "$resource_name" >&2
    return 1
  else
    inspection_status=$?
    if [ "$inspection_status" -ne 1 ]; then
      printf 'mastodon-fixture: could not verify differential %s cleanup for %s (Podman exit %s)\n' \
        "$resource_kind" "$resource_name" "$inspection_status" >&2
      return 1
    fi
  fi
}

cleanup_and_verify_differential() {
  finished_web=$WEB_CONTAINER
  finished_redis=$REDIS_CONTAINER
  finished_postgres=$PG_CONTAINER
  finished_volume=$PG_VOLUME
  finished_network=$NETWORK
  finished_root=$DIFFERENTIAL_ROOT
  cleanup_containers
  cleanup_failed=false
  for container in "$finished_web" "$finished_redis" "$finished_postgres"
  do
    [ -n "$container" ] || continue
    verify_podman_resource_absent container "$container" || cleanup_failed=true
  done
  verify_podman_resource_absent volume "$finished_volume" || cleanup_failed=true
  verify_podman_resource_absent network "$finished_network" || cleanup_failed=true
  if [ -e "$finished_root" ]; then
    printf 'mastodon-fixture: differential run root leaked after cleanup: %s\n' \
      "$finished_root" >&2
    cleanup_failed=true
  fi
  [ "$cleanup_failed" = false ]
}

differential_exit_cleanup() {
  original_status=$?
  trap - EXIT HUP INT TERM
  cleanup_status=0
  cleanup_and_verify_differential || cleanup_status=$?
  if [ "$original_status" -ne 0 ]; then
    exit "$original_status"
  fi
  exit "$cleanup_status"
}

finish_differential() {
  cleanup_and_verify_differential || die 'differential cleanup verification failed'
  trap - EXIT HUP INT TERM
}

# The pinned animated profile fixture exceeds HTTP deadlines without optimization.
# Keep discovery/execution consistent without changing other tests or CLI builds.
with_differential_test_profile() (
  case "$1" in
    mixed_profile_media) export CARGO_PROFILE_TEST_OPT_LEVEL=3 ;;
  esac
  shift
  "$@"
)

