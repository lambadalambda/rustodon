    LDAP_ENABLED='false' \
    PAM_ENABLED='false' \
    CAS_ENABLED='false' \
    SAML_ENABLED='false' \
    OIDC_ENABLED='false' \
    OMNIAUTH_ONLY='false' \
    ONE_CLICK_SSO_LOGIN='false' \
    cargo run --locked --quiet -- preflight 2>&1) && preflight_status=0 || preflight_status=$?

  if [ -z "$expected_code" ]; then
    [ "$preflight_status" -eq 0 ] || die "canonical preflight failed: $preflight_output"
  else
    [ "$preflight_status" -ne 0 ] || die "preflight unexpectedly accepted $expected_code case"
