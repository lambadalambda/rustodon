die() {
  printf 'mastodon-fixture: %s\n' "$*" >&2
  exit 1
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

# Deliberately pass only process/runtime variables needed by rootless Podman.
# Database, domain, and Rails secret values are constants below, never inherited.
run_podman() {
  env -i \
    PATH="$PATH" \
    HOME="${HOME:-/tmp}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
    podman "$@"
}

cleanup_containers() {
  if [ -n "$PG_CONTAINER" ]; then
    run_podman rm -f --volumes "$PG_CONTAINER" >/dev/null 2>&1 || true
    PG_CONTAINER=''
  fi
  if [ -n "$PG_VOLUME" ]; then
    run_podman volume rm -f "$PG_VOLUME" >/dev/null 2>&1 || true
    PG_VOLUME=''
  fi
  if [ -n "$NETWORK" ]; then
    run_podman network rm "$NETWORK" >/dev/null 2>&1 || true
    NETWORK=''
  fi
}

finish_database() {
  finished_volume=$PG_VOLUME
  cleanup_containers
  trap - EXIT HUP INT TERM
  if run_podman volume exists "$finished_volume"; then
    die "fixture PostgreSQL volume leaked after cleanup: $finished_volume"
  fi
}

verify_image() {
  image_label=$1
  index_image=$2
  manifest_digest=$3
  child_image=$4

  manifest=$(run_podman manifest inspect "$index_image")
  printf '%s\n' "$manifest" | grep -F "\"digest\": \"$manifest_digest\"" >/dev/null 2>&1 ||
    die "$image_label index does not contain pinned linux/amd64 child $manifest_digest"
  run_podman pull --quiet --platform "$PLATFORM" "$child_image" >/dev/null
  inspected=$(run_podman image inspect "$child_image" --format '{{.Os}}/{{.Architecture}}|{{.Digest}}')
  if [ "$inspected" != "$PLATFORM|$manifest_digest" ]; then
    die "$image_label child mismatch: expected $PLATFORM|$manifest_digest, got $inspected"
  fi
}

verify_images() {
  verify_image Mastodon "$MASTODON_INDEX_IMAGE" "$MASTODON_MANIFEST_DIGEST" "$MASTODON_IMAGE"
  verify_image PostgreSQL "$POSTGRES_INDEX_IMAGE" "$POSTGRES_MANIFEST_DIGEST" "$POSTGRES_IMAGE"
}

start_database() {
  need_command podman
  NETWORK="rustodon-fixture-v4-6-5-network-$$"
  PG_CONTAINER="rustodon-fixture-v4-6-5-postgres-$$"
  PG_VOLUME="rustodon-fixture-v4-6-5-postgres-$$"
  trap cleanup_containers EXIT HUP INT TERM

  run_podman network create "$NETWORK" >/dev/null
  run_podman volume create \
    --label 'io.rustodon.fixture=mastodon-v4.6.5' \
    --label "io.rustodon.fixture.session=$$" \
    "$PG_VOLUME" >/dev/null
  run_podman run -d \
    --platform "$PLATFORM" \
    --name "$PG_CONTAINER" \
    --label 'io.rustodon.fixture=mastodon-v4.6.5' \
    --network "$NETWORK" \
    --volume "$PG_VOLUME:/var/lib/postgresql/data" \
    --env "POSTGRES_DB=$DATABASE_NAME" \
    --env "POSTGRES_USER=$DATABASE_USER" \
    --env "POSTGRES_PASSWORD=$DATABASE_PASSWORD" \
    "$POSTGRES_IMAGE" >/dev/null

  attempts=0
  consecutive_ready_checks=0
  while [ "$consecutive_ready_checks" -lt 2 ]
  do
    if run_podman exec "$PG_CONTAINER" psql \
      --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
      --tuples-only --no-align --command 'SELECT 1' >/dev/null 2>&1
    then
      consecutive_ready_checks=$((consecutive_ready_checks + 1))
    else
      consecutive_ready_checks=0
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 60 ]; then
      die 'PostgreSQL fixture container did not become ready'
    fi
    sleep 1
  done
}

