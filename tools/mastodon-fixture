  CUTOVER_MEDIA_ROOT="$cutover_media_root"
  cutover_preflight "$reader_url"
  run_worker_cli "$migrator_url" admin migrate-operational-schema
  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    < "$ROOT/docs/mastodon-refresh-instances.sql" >/dev/null
  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --set writer_role="$DIFFERENTIAL_WRITER" \
    --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    < "$ROOT/docs/mastodon-writer-grants.sql" >/dev/null
  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname "$DATABASE_NAME" >/dev/null <<EOF
GRANT USAGE ON SCHEMA rustodon TO $WORKER_RUNTIME;
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE
  rustodon.durable_jobs, rustodon.outbox_events, rustodon.idempotency_keys,
  rustodon.ordering_markers, rustodon.domain_health, rustodon.heartbeats,
  rustodon.rate_limit_windows TO $WORKER_RUNTIME;
GRANT SELECT, INSERT, DELETE ON TABLE rustodon.remote_fetch_leases TO $WORKER_RUNTIME;
GRANT SELECT ON TABLE rustodon.schema_migrations TO $WORKER_RUNTIME;
GRANT USAGE ON SEQUENCE rustodon.durable_jobs_id_seq, rustodon.outbox_events_id_seq
  TO $WORKER_RUNTIME;
EOF
  cutover_preflight "$runtime_url" "$writer_url"

  start_worker_cli "$runtime_url" "$cutover_worker_log" "$writer_url" &
  cutover_worker_pid=$!
  ready=false
  for _ in $(seq 1 120); do
    if run_worker_cli "$runtime_url" admin worker-readiness >/dev/null 2>&1; then
      ready=true
      break
    fi
    sleep 1
  done
  [ "$ready" = true ] || die "cutover worker did not become ready; inspect $cutover_worker_log"
  cutover_web_port=$((18000 + ($$ % 1000)))
  run_web_cli "$runtime_url" "$writer_url" "$cutover_web_port" "$cutover_web_log" &
  cutover_web_pid=$!
  wait_for_http "http://127.0.0.1:$cutover_web_port/health"
  wait_for_http "http://127.0.0.1:$cutover_web_port/ready"
  case "${RUSTODON_BROWSER_AUTH:-false}" in
    true)
      cutover_browser_user_restore="$ROOT/target/cutover-browser-user-$$.sql"
      cutover_browser_poll_status_file="$ROOT/target/cutover-browser-poll-status-$$"
      rm -f "$cutover_browser_poll_status_file"
      cutover_browser_login_activity_max=$(run_podman exec "$PG_CONTAINER" psql \
        --set ON_ERROR_STOP=1 --tuples-only --no-align \
        --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
        --command 'SELECT COALESCE(max(id), 0) FROM public.login_activities WHERE user_id = 101' | tr -d '[:space:]')
      cutover_browser_session_activation_max=$(run_podman exec "$PG_CONTAINER" psql \
        --set ON_ERROR_STOP=1 --tuples-only --no-align \
        --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
        --command 'SELECT COALESCE(max(id), 0) FROM public.session_activations WHERE user_id = 101' | tr -d '[:space:]')
      cutover_browser_token_max=$(run_podman exec "$PG_CONTAINER" psql \
        --set ON_ERROR_STOP=1 --tuples-only --no-align \
        --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
        --command 'SELECT COALESCE(max(id), 0) FROM public.oauth_access_tokens WHERE resource_owner_id = 101' | tr -d '[:space:]')
      cutover_browser_voter_login_activity_max=$(run_podman exec "$PG_CONTAINER" psql \
        --set ON_ERROR_STOP=1 --tuples-only --no-align \
        --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
        --command 'SELECT COALESCE(max(id), 0) FROM public.login_activities WHERE user_id = 102' | tr -d '[:space:]')
      cutover_browser_voter_session_activation_max=$(run_podman exec "$PG_CONTAINER" psql \
        --set ON_ERROR_STOP=1 --tuples-only --no-align \
        --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
        --command 'SELECT COALESCE(max(id), 0) FROM public.session_activations WHERE user_id = 102' | tr -d '[:space:]')
      cutover_browser_voter_token_max=$(run_podman exec "$PG_CONTAINER" psql \
        --set ON_ERROR_STOP=1 --tuples-only --no-align \
        --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
        --command 'SELECT COALESCE(max(id), 0) FROM public.oauth_access_tokens WHERE resource_owner_id = 102' | tr -d '[:space:]')
      case "$cutover_browser_login_activity_max:$cutover_browser_session_activation_max:$cutover_browser_token_max:$cutover_browser_voter_login_activity_max:$cutover_browser_voter_session_activation_max:$cutover_browser_voter_token_max" in
        ''|*[!0-9:]*) die 'invalid browser authentication fixture baselines' ;;
      esac
      run_podman exec "$PG_CONTAINER" psql \
        --set ON_ERROR_STOP=1 --tuples-only --no-align \
        --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
        --command "SELECT format('UPDATE public.users SET current_sign_in_at = %L, last_sign_in_at = %L, sign_in_count = %s, consumed_timestep = %L, updated_at = %L, otp_backup_codes = %L WHERE id = 101;', current_sign_in_at, last_sign_in_at, sign_in_count, consumed_timestep, updated_at, otp_backup_codes) FROM public.users WHERE id = 101" \
        > "$cutover_browser_user_restore"
      run_podman exec "$PG_CONTAINER" psql \
        --set ON_ERROR_STOP=1 --tuples-only --no-align \
        --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
        --command "SELECT format('UPDATE public.users SET current_sign_in_at = %L, last_sign_in_at = %L, sign_in_count = %s, consumed_timestep = %L, updated_at = %L, otp_backup_codes = %L WHERE id = 102;', current_sign_in_at, last_sign_in_at, sign_in_count, consumed_timestep, updated_at, otp_backup_codes) FROM public.users WHERE id = 102" \
        >> "$cutover_browser_user_restore"
      run_podman exec "$PG_CONTAINER" psql \
        --set ON_ERROR_STOP=1 --tuples-only --no-align \
        --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
        --command "SELECT format('SELECT setval(''public.login_activities_id_seq'', %s, %L);', last_value, is_called) FROM public.login_activities_id_seq UNION ALL SELECT format('SELECT setval(''public.oauth_access_tokens_id_seq'', %s, %L);', last_value, is_called) FROM public.oauth_access_tokens_id_seq UNION ALL SELECT format('SELECT setval(''public.session_activations_id_seq'', %s, %L);', last_value, is_called) FROM public.session_activations_id_seq" \
        >> "$cutover_browser_user_restore"
      # Browser persistence is asserted before replay. Restore only this user's
      # exact prior row (or absence), leaving the full public-data guard intact.
      run_podman exec "$PG_CONTAINER" psql \
        --set ON_ERROR_STOP=1 --tuples-only --no-align \
        --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
        --command "SELECT sql FROM (
  SELECT 0 AS step, 'DELETE FROM public.web_settings WHERE user_id = 101;' AS sql
  UNION ALL
  SELECT 1, format('INSERT INTO public.web_settings (id, created_at, data, updated_at, user_id) VALUES (%s, %L, %L, %L, 101);', id, created_at, data, updated_at) FROM public.web_settings WHERE user_id = 101
  UNION ALL
  SELECT 2, format('SELECT setval(''public.web_settings_id_seq'', %s, %L);', last_value, is_called) FROM public.web_settings_id_seq
  UNION ALL
  SELECT 3, format('DELETE FROM public.account_stats WHERE account_id = 116844606259201001; INSERT INTO public.account_stats SELECT * FROM jsonb_populate_record(NULL::public.account_stats, %L::jsonb);', to_jsonb(stats)::text) FROM public.account_stats AS stats WHERE account_id = 116844606259201001
  UNION ALL
  SELECT 4, format('SELECT setval(''public.statuses_id_seq'', %s, %L);', last_value, is_called) FROM public.statuses_id_seq
  UNION ALL
  SELECT 5, format('SELECT setval(''public.status_stats_id_seq'', %s, %L);', last_value, is_called) FROM public.status_stats_id_seq
  UNION ALL
  SELECT 6, format('SELECT setval(''public.conversations_id_seq'', %s, %L);', last_value, is_called) FROM public.conversations_id_seq
  UNION ALL
  SELECT 7, format('SELECT setval(''public.polls_id_seq'', %s, %L);', last_value, is_called) FROM public.polls_id_seq
  UNION ALL
  SELECT 8, format('SELECT setval(''public.poll_votes_id_seq'', %s, %L);', last_value, is_called) FROM public.poll_votes_id_seq
) AS restore_statements ORDER BY step;" \
        >> "$cutover_browser_user_restore"
      ;;
    false) ;;
    *) die 'RUSTODON_BROWSER_AUTH must be true or false' ;;
  esac
  case "${RUSTODON_BROWSER_SMOKE:-false}" in
    true)
      cutover_start_browser_tls
      RUSTODON_BROWSER_RECORD="${RUSTODON_BROWSER_RECORD:-}" \
        RUSTODON_BROWSER_CA_FILE="$cutover_tls_dir/ca.pem" \
        RUSTODON_BROWSER_SPKI="$cutover_tls_spki" \
        RUSTODON_BROWSER_SCREENSHOT="${RUSTODON_BROWSER_SCREENSHOT:-}" \
        RUSTODON_BROWSER_AUTH="${RUSTODON_BROWSER_AUTH:-false}" \
        RUSTODON_BROWSER_EMAIL="${RUSTODON_BROWSER_EMAIL:-}" \
        RUSTODON_BROWSER_PASSWORD="${RUSTODON_BROWSER_PASSWORD:-}" \
        RUSTODON_BROWSER_OTP="${RUSTODON_BROWSER_OTP:-}" \
        RUSTODON_BROWSER_VOTER_EMAIL="${RUSTODON_BROWSER_VOTER_EMAIL:-}" \
        RUSTODON_BROWSER_VOTER_PASSWORD="${RUSTODON_BROWSER_VOTER_PASSWORD:-}" \
        RUSTODON_BROWSER_VOTER_OTP="${RUSTODON_BROWSER_VOTER_OTP:-}" \
        RUSTODON_BROWSER_POLL_STATUS_FILE="$cutover_browser_poll_status_file" \
        "$ROOT/tools/rustodon-browser-smoke" \
        "https://$LOCAL_DOMAIN:$cutover_tls_port" "$LOCAL_DOMAIN"
      cutover_stop_browser_tls
      if [ -n "$cutover_browser_poll_status_file" ]; then
        [ -s "$cutover_browser_poll_status_file" ] ||
          die 'browser poll smoke did not record its generated status ID'
        cutover_browser_poll_status_id=$(tr -d '[:space:]' < "$cutover_browser_poll_status_file")
        case "$cutover_browser_poll_status_id" in
          ''|*[!0-9]*) die 'browser poll smoke recorded an invalid status ID' ;;
        esac
        rm -f "$cutover_browser_poll_status_file"
        cutover_browser_poll_status_file=''
      fi
      ;;
    false) ;;
    *) die 'RUSTODON_BROWSER_SMOKE must be true or false' ;;
  esac
  if [ -n "$cutover_browser_user_restore" ]; then
    if [ -n "$cutover_browser_poll_status_id" ]; then
      run_podman exec "$PG_CONTAINER" psql \
      --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
      --command "BEGIN;
CREATE TEMP TABLE rustodon_browser_poll_statuses ON COMMIT DROP AS
  SELECT id, poll_id, conversation_id FROM public.statuses
   WHERE id = $cutover_browser_poll_status_id
     AND account_id = 116844606259201001 AND poll_id IS NOT NULL;
DO \$\$ BEGIN
  IF (SELECT count(*) FROM rustodon_browser_poll_statuses) <> 1 THEN
    RAISE EXCEPTION 'expected exactly one browser poll status';
  END IF;
  IF NOT EXISTS (
    SELECT 1 FROM public.polls
     WHERE id = (SELECT poll_id FROM rustodon_browser_poll_statuses)
  ) THEN
    RAISE EXCEPTION 'browser poll is missing before exact fixture cleanup';
  END IF;
END \$\$;
DELETE FROM public.notifications WHERE activity_type = 'Poll'
  AND activity_id IN (SELECT poll_id FROM rustodon_browser_poll_statuses);
DELETE FROM public.poll_votes WHERE poll_id IN (SELECT poll_id FROM rustodon_browser_poll_statuses);
UPDATE public.statuses SET poll_id = NULL, conversation_id = NULL
 WHERE id IN (SELECT id FROM rustodon_browser_poll_statuses);
DELETE FROM public.polls WHERE id IN (SELECT poll_id FROM rustodon_browser_poll_statuses);
DELETE FROM public.status_stats WHERE status_id IN (SELECT id FROM rustodon_browser_poll_statuses);
DELETE FROM public.statuses WHERE id IN (SELECT id FROM rustodon_browser_poll_statuses);
DELETE FROM public.conversations WHERE id IN (
  SELECT conversation_id FROM rustodon_browser_poll_statuses WHERE conversation_id IS NOT NULL
);
COMMIT;" >/dev/null
    fi
    run_podman exec -i "$PG_CONTAINER" psql \
      --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
      < "$cutover_browser_user_restore" >/dev/null
    run_podman exec "$PG_CONTAINER" psql \
      --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
      --command "DELETE FROM public.session_activations WHERE (user_id = 101 AND id > $cutover_browser_session_activation_max) OR (user_id = 102 AND id > $cutover_browser_voter_session_activation_max); DELETE FROM public.oauth_access_tokens WHERE (resource_owner_id = 101 AND id > $cutover_browser_token_max) OR (resource_owner_id = 102 AND id > $cutover_browser_voter_token_max); DELETE FROM public.login_activities WHERE (user_id = 101 AND id > $cutover_browser_login_activity_max) OR (user_id = 102 AND id > $cutover_browser_voter_login_activity_max);" \
      >/dev/null
    rm -f "$cutover_browser_user_restore" "$cutover_browser_poll_status_file"
    cutover_browser_user_restore=''
    cutover_browser_poll_status_file=''
  fi
  RUSTODON_SMOKE_DOMAIN="$LOCAL_DOMAIN" \
    RUSTODON_SMOKE_HOST="$LOCAL_DOMAIN" \
    RUSTODON_SMOKE_TOKEN='fixture-bearer-token-v4-6-5' \
    "$ROOT/tools/rustodon-smoke" \
    "http://127.0.0.1:$cutover_web_port" \
    116844606259201001 alice \
    "http://127.0.0.1:$cutover_web_port/system/accounts/avatars/116/844/606/259/201/001/original/0112603425bb49c1.png"

  cutover_media_description='Rustodon cutover rollback attachment'
  cutover_media_sequence=$(run_podman exec "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --tuples-only --no-align --field-separator '|' \
    --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    --command 'SELECT last_value, is_called FROM public.media_attachments_id_seq')
  IFS='|' read -r cutover_media_sequence_value cutover_media_sequence_called <<EOF
$cutover_media_sequence
EOF
  case "$cutover_media_sequence_value" in
    ''|*[!0-9]*) die "invalid media attachment sequence value: $cutover_media_sequence" ;;
  esac
  case "$cutover_media_sequence_called" in
    t|f) ;;
    *) die "invalid media attachment sequence state: $cutover_media_sequence" ;;
  esac
  curl --silent --show-error --fail --max-time 30 \
    --header "Host: $LOCAL_DOMAIN" \
    --header 'Authorization: Bearer fixture-bearer-token-v4-6-5' \
    --form "file=@$ROOT/fixtures/worker-media/mastodon-v4.6.5/attachment.jpg;type=image/jpeg" \
    --form "description=$cutover_media_description" \
    "http://127.0.0.1:$cutover_web_port/api/v1/media" >/dev/null
  cutover_media_id=$(run_podman exec "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --tuples-only --no-align \
    --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    --command "SELECT id FROM public.media_attachments WHERE account_id = 116844606259201001 AND id > $cutover_media_sequence_value AND description = '$cutover_media_description' ORDER BY id DESC LIMIT 1")
  case "$cutover_media_id" in
    ''|*[!0-9]*) die "Rustodon media upload did not create an isolated attachment: $cutover_media_id" ;;
  esac

  cutover_stop_processes
  run_podman rm -f --volumes "$REDIS_CONTAINER" >/dev/null 2>&1 || true
  REDIS_CONTAINER=''
  start_differential_redis
  start_differential_web "$DATABASE_NAME" "$cutover_media_root" ro false
  mastodon_web_endpoint=$(run_podman port "$WEB_CONTAINER" 3000/tcp)
  mastodon_web_port=${mastodon_web_endpoint##*:}
  case "$mastodon_web_port" in
    ''|*[!0-9]*) die "invalid published Mastodon web endpoint: $mastodon_web_endpoint" ;;
  esac
  RUSTODON_SMOKE_DOMAIN="$LOCAL_DOMAIN" \
    RUSTODON_SMOKE_HOST="$LOCAL_DOMAIN" \
    RUSTODON_SMOKE_CHECK_READY=false \
    RUSTODON_SMOKE_FORWARD_PROTO=https \
    RUSTODON_SMOKE_TOKEN='fixture-bearer-token-v4-6-5' \
    "$ROOT/tools/rustodon-smoke" \
    "http://127.0.0.1:$mastodon_web_port" \
    116844606259201001 alice \
    "http://127.0.0.1:$mastodon_web_port/system/accounts/avatars/116/844/606/259/201/001/original/0112603425bb49c1.png"
  cutover_media_paths=$(run_podman exec "$WEB_CONTAINER" bundle exec rails runner \
    "require 'uri'; media = MediaAttachment.find($cutover_media_id); meta = media.file_meta || {}; checks = { account: media.account_id == 116844606259201001, status: media.status_id.nil?, scheduled: media.scheduled_status_id.nil?, description: media.description == '$cutover_media_description', content_type: media.file_content_type == 'image/jpeg', filename: media.file_file_name.to_s.end_with?('.jpg'), original_width: Integer(meta.dig('original', 'width') || 0) == 600, original_height: Integer(meta.dig('original', 'height') || 0) == 400, small_width: Integer(meta.dig('small', 'width') || 0) == 588, small_height: Integer(meta.dig('small', 'height') || 0) == 392 }; abort \"reopened Rails media metadata mismatch: checks=#{checks.inspect} filename=#{media.file_file_name.inspect} meta=#{meta.inspect} original=#{media.file.path(:original)} small=#{media.file.path(:small)}\" unless checks.values.all?; puts [URI.parse(media.file.url(:original)).path, URI.parse(media.file.url(:small)).path].join('|')")
  IFS='|' read -r cutover_media_original_path cutover_media_small_path <<EOF
$cutover_media_paths
EOF
  case "$cutover_media_original_path:$cutover_media_small_path" in
    /system/*:/system/*) ;;
    *) die "reopened Rails media URLs were not Paperclip system paths: $cutover_media_paths" ;;
  esac
  curl --silent --show-error --fail --max-time 15 \
    --header "Host: $LOCAL_DOMAIN" \
    --header 'Authorization: Bearer fixture-bearer-token-v4-6-5' \
    "http://127.0.0.1:$mastodon_web_port/api/v1/media/$cutover_media_id" >/dev/null
  curl --silent --show-error --fail --head --max-time 15 \
    --header "Host: $LOCAL_DOMAIN" \
    "http://127.0.0.1:$mastodon_web_port$cutover_media_original_path" >/dev/null
  curl --silent --show-error --fail --head --max-time 15 \
    --header "Host: $LOCAL_DOMAIN" \
    "http://127.0.0.1:$mastodon_web_port$cutover_media_small_path" >/dev/null
  run_podman rm -f --volumes "$WEB_CONTAINER" >/dev/null 2>&1 || true
  WEB_CONTAINER=''
  run_podman exec "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    --command "DELETE FROM public.media_attachments WHERE id = $cutover_media_id AND account_id = 116844606259201001; SELECT setval('public.media_attachments_id_seq', $cutover_media_sequence_value, '$cutover_media_sequence_called'::boolean);" >/dev/null
  cutover_media_remaining=$(run_podman exec "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --tuples-only --no-align \
    --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    --command "SELECT count(*) FROM public.media_attachments WHERE id = $cutover_media_id")
  [ "$cutover_media_remaining" = '0' ] ||
    die "cutover media attachment was not removed: $cutover_media_remaining"
  rm -rf "$cutover_media_root"
  mkdir "$cutover_media_root"
  cp -a "$fixture/media/." "$cutover_media_root/"
  chmod -R u+rwX "$cutover_media_root"
  run_rails "$fixture" 'bundle exec rails runner /fixture/verify.rb'
  dump_cutover_public_state "$cutover_after_prefix"
  cp -a "$cutover_media_root" "$cutover_after_media"
  cmp -s "${cutover_before_prefix}-catalog" "${cutover_after_prefix}-catalog" ||
    die 'cutover changed the Mastodon public catalog'
  cmp -s "${cutover_before_prefix}-schema" "${cutover_after_prefix}-schema" ||
    die 'cutover changed the Mastodon public schema'
  if ! cmp -s "${cutover_before_prefix}-data" "${cutover_after_prefix}-data"; then
    diff -u "${cutover_before_prefix}-data" "${cutover_after_prefix}-data" >&2 || true
    die 'cutover changed Mastodon public data'
  fi
  cmp -s "${cutover_before_prefix}-auth" "${cutover_after_prefix}-auth" ||
    die 'cutover changed stable Mastodon authentication data'
  diff -r "$cutover_before_media" "$cutover_after_media" >/dev/null ||
    die 'cutover changed Mastodon media'
  finish_database
  rm -rf "$cutover_before_media" "$cutover_after_media" \
    "${cutover_before_prefix}-catalog" "${cutover_before_prefix}-schema" \
    "${cutover_before_prefix}-data" "${cutover_after_prefix}-catalog" \
    "${cutover_before_prefix}-auth" "${cutover_after_prefix}-schema" \
    "${cutover_after_prefix}-data" "${cutover_after_prefix}-auth" \
    "$cutover_worker_log" "$cutover_web_log" "$cutover_media_root"
  trap - EXIT HUP INT TERM
  printf 'fixture cutover and rollback rehearsal passed for Mastodon %s\n' "$RELEASE"
}

validate_differential_case() {
  case_name=$1
  case "$case_name" in
    ''|*[!a-z0-9_]*)
      die 'differential case must use lowercase letters, digits, or underscores'
      ;;
  esac
  case "$case_name" in
    account_settings|actor_media_root_url|admin_create_user|authorized_fetch_read_routes_require_signatures|browser_authentication|browser_recovery_fences|browser_reauthentication_limits|browser_two_factor_management|core_rest_serializers|extended_description|extended_description_limited_mode|federation_discovery|instance_v2|local_paperclip_media|local_paperclip_deleted_media|local_web_client_shell|media_writes|mixed_profile_media|notification_writes|oauth_authorization_code|oauth_bearer_authentication|password_recovery|poll_lifecycle|report_writes|rest_protocol_contracts|status_authorization_matrix|write_transactions) ;;
    *) die "unknown differential case: $case_name" ;;
  esac
}

prepare_differential_database() {
  database=$1
  side=$2

  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname postgres >/dev/null <<EOF
COMMENT ON DATABASE $database IS 'rustodon differential run=$DIFFERENTIAL_RUN_ID side=$side';
REVOKE ALL ON DATABASE $database FROM PUBLIC;
REVOKE ALL ON DATABASE $database FROM $DIFFERENTIAL_READER;
GRANT CONNECT ON DATABASE $database TO $DIFFERENTIAL_READER;
EOF

  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname "$database" >/dev/null <<EOF
INSERT INTO settings (var, value, created_at, updated_at)
VALUES ('wrapstodon', E'--- false\n', TIMESTAMP '2026-07-01 00:00:00', TIMESTAMP '2026-07-01 00:00:00')
ON CONFLICT (var) DO UPDATE
SET value = EXCLUDED.value, updated_at = EXCLUDED.updated_at;
REVOKE ALL ON SCHEMA public FROM PUBLIC;
REVOKE ALL ON SCHEMA public FROM $DIFFERENTIAL_READER;
GRANT USAGE ON SCHEMA public TO $DIFFERENTIAL_READER;
REVOKE ALL ON ALL TABLES IN SCHEMA public FROM $DIFFERENTIAL_READER;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO $DIFFERENTIAL_READER;
REVOKE ALL ON ALL SEQUENCES IN SCHEMA public FROM $DIFFERENTIAL_READER;
REVOKE EXECUTE ON ALL FUNCTIONS IN SCHEMA public FROM PUBLIC;
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA public FROM $DIFFERENTIAL_READER;
EOF
}

