    PAPERCLIP_ROOT_PATH="$FIXTURE_DIR/media" PAPERCLIP_ROOT_URL='/system' \
    TRUSTED_PROXY_IP='127.0.0.1/32,::1/128' \
    SIDEKIQ_REDIS_HOST='127.0.0.1' SIDEKIQ_REDIS_PORT="$PREFLIGHT_REDIS_PORT" \
    SIDEKIQ_REDIS_DB='0' \
    SECRET_KEY_BASE='0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef' \
    ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY='11111111111111111111111111111111' \
    ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT='22222222222222222222222222222222' \
    ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY='33333333333333333333333333333333' \
    S3_ENABLED='false' SWIFT_ENABLED='false' AZURE_ENABLED='false' \
    LDAP_ENABLED='false' PAM_ENABLED='false' CAS_ENABLED='false' \
    SAML_ENABLED='false' OIDC_ENABLED='false' OMNIAUTH_ONLY='false' \
    ONE_CLICK_SSO_LOGIN='false' \
    cargo run --locked --quiet -- preflight 2>&1); then
    runtime_diagnostic=$(run_podman exec "$PG_CONTAINER" psql \
      --set ON_ERROR_STOP=1 --tuples-only --no-align \
      --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
      --command "SELECT rolname || E'|' || rolinherit || '|' || pg_catalog.has_database_privilege(oid, current_database(), 'CONNECT') || '|' || pg_catalog.has_database_privilege(oid, current_database(), 'TEMP') || '|' || pg_catalog.has_schema_privilege(oid, 'rustodon', 'USAGE') FROM pg_catalog.pg_roles WHERE rolname IN ('$WORKER_RUNTIME', '$DIFFERENTIAL_WRITER') ORDER BY rolname")
    runtime_acl=$(run_podman exec "$PG_CONTAINER" psql \
      --set ON_ERROR_STOP=1 --tuples-only --no-align \
      --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
      --command "SELECT c.relname || '=' || COALESCE(c.relacl::text, '') FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = 'rustodon' ORDER BY c.relname")
    runtime_probe=$(run_podman exec --env "PGPASSWORD=$WORKER_RUNTIME_PASSWORD" "$PG_CONTAINER" psql \
      --set ON_ERROR_STOP=1 --tuples-only --no-align \
      --username "$WORKER_RUNTIME" --dbname "$DATABASE_NAME" \
      --command "SELECT current_user || '|' || session_user || '|' || current_setting('transaction_read_only'); SELECT last_value FROM public.accounts_id_seq; SELECT count(*) FROM public.accounts; SELECT count(*) FROM rustodon.schema_migrations" 2>&1 || true)
    runtime_reads=$(run_podman exec "$PG_CONTAINER" psql \
      --set ON_ERROR_STOP=1 --tuples-only --no-align \
      --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
      --command "SELECT table_name FROM unnest(ARRAY['account_aliases','account_conversations','account_deletion_requests','account_domain_blocks','account_migrations','account_notes','account_pins','account_relationship_severance_events','account_stats','account_statuses_cleanup_policies','account_warnings','accounts','accounts_tags','appeals','blocks','bookmarks','canonical_email_blocks','collection_items','collection_reports','collections','conversation_mutes','conversations','custom_emojis','custom_filter_keywords','custom_filter_statuses','custom_filters','domain_allows','domain_blocks','favourites','featured_tags','follow_requests','follows','generated_annual_reports','instances','keypairs','list_accounts','lists','markers','media_attachments','mentions','mutes','notification_permissions','notification_policies','notification_requests','notifications','oauth_access_tokens','oauth_applications','poll_votes','polls','preview_card_providers','preview_cards','preview_cards_statuses','quotes','relays','relationship_severance_events','report_notes','reports','rule_translations','rules','scheduled_statuses','site_uploads','status_edits','status_pins','status_stats','statuses','statuses_tags','tag_follows','tagged_objects','tags','tombstones','user_roles','users','invites','webauthn_credentials','web_push_subscriptions']::text[]) table_name WHERE NOT pg_catalog.has_table_privilege('$WORKER_RUNTIME', format('public.%I', table_name), 'SELECT')")
    runtime_privilege_diff=$(run_podman exec "$PG_CONTAINER" psql \
      --set ON_ERROR_STOP=1 --tuples-only --no-align \
      --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
      --command "WITH actual AS (SELECT c.relname || ':' || acl.privilege_type || ':' || acl.is_grantable::text AS privilege FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace CROSS JOIN LATERAL pg_catalog.aclexplode(c.relacl) acl WHERE n.nspname = 'rustodon' AND acl.grantee = (SELECT oid FROM pg_catalog.pg_roles WHERE rolname = '$WORKER_RUNTIME') UNION ALL SELECT 'schema:' || acl.privilege_type || ':' || acl.is_grantable::text FROM pg_catalog.pg_namespace n CROSS JOIN LATERAL pg_catalog.aclexplode(n.nspacl) acl WHERE n.nspname = 'rustodon' AND acl.grantee = (SELECT oid FROM pg_catalog.pg_roles WHERE rolname = '$WORKER_RUNTIME') UNION ALL SELECT 'function:' || p.proname || ':' || acl.privilege_type || ':' || acl.is_grantable::text FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid = p.pronamespace CROSS JOIN LATERAL pg_catalog.aclexplode(p.proacl) acl WHERE n.nspname = 'rustodon' AND acl.grantee = (SELECT oid FROM pg_catalog.pg_roles WHERE rolname = '$WORKER_RUNTIME')), expected AS (SELECT unnest(ARRAY['domain_health:DELETE:false','domain_health:INSERT:false','domain_health:SELECT:false','domain_health:UPDATE:false','durable_jobs:DELETE:false','durable_jobs:INSERT:false','durable_jobs:SELECT:false','durable_jobs:UPDATE:false','durable_jobs_id_seq:USAGE:false','heartbeats:DELETE:false','heartbeats:INSERT:false','heartbeats:SELECT:false','heartbeats:UPDATE:false','idempotency_keys:DELETE:false','idempotency_keys:INSERT:false','idempotency_keys:SELECT:false','idempotency_keys:UPDATE:false','ordering_markers:DELETE:false','ordering_markers:INSERT:false','ordering_markers:SELECT:false','ordering_markers:UPDATE:false','outbox_events:DELETE:false','outbox_events:INSERT:false','outbox_events:SELECT:false','outbox_events:UPDATE:false','outbox_events_id_seq:USAGE:false','rate_limit_windows:DELETE:false','rate_limit_windows:INSERT:false','rate_limit_windows:SELECT:false','rate_limit_windows:UPDATE:false','remote_fetch_leases:DELETE:false','remote_fetch_leases:INSERT:false','remote_fetch_leases:SELECT:false','schema:USAGE:false','schema_migrations:SELECT:false']::text[]) AS privilege) SELECT 'extra:' || privilege FROM actual WHERE NOT EXISTS (SELECT 1 FROM expected WHERE expected.privilege = actual.privilege) UNION ALL SELECT 'missing:' || privilege FROM expected WHERE NOT EXISTS (SELECT 1 FROM actual WHERE actual.privilege = expected.privilege) ORDER BY 1")
    die "cutover preflight failed: $preflight_output\nruntime roles: $runtime_diagnostic\nruntime ACL: $runtime_acl\nruntime probe: $runtime_probe\nruntime missing reads: $runtime_reads\nruntime privilege diff: $runtime_privilege_diff"
  fi
}

cutover_test() {
  "$ROOT/tools/verify-worker-media"
  fixture=$FIXTURE_DIR
  umask 077
  verify_static "$fixture"
  verify_differential_images
  start_database publish
  cutover_worker_pid=''
  cutover_web_pid=''
  cutover_tls_pid=''
  cutover_tls_dir=''
  cutover_worker_log="$ROOT/target/cutover-worker-$$.log"
  cutover_web_log="$ROOT/target/cutover-web-$$.log"
  cutover_before_prefix="$ROOT/target/cutover-before-$$"
  cutover_after_prefix="$ROOT/target/cutover-after-$$"
  cutover_before_media="$ROOT/target/cutover-before-media-$$"
  cutover_after_media="$ROOT/target/cutover-after-media-$$"
  cutover_browser_user_restore=''
  cutover_browser_login_activity_max=''
  cutover_browser_session_activation_max=''
  cutover_browser_token_max=''
  cutover_browser_poll_status_file=''
  cutover_browser_poll_status_id=''
  cutover_media_root="$ROOT/target/cutover-media-$$"
  trap cutover_abort EXIT HUP INT TERM

