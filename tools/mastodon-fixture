EOF
  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname "$DATABASE_NAME" >/dev/null <<EOF
GRANT USAGE ON SCHEMA public TO $OPERATIONAL_MIGRATOR;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO $OPERATIONAL_MIGRATOR;
GRANT SELECT ON ALL SEQUENCES IN SCHEMA public TO $OPERATIONAL_MIGRATOR;
REVOKE ALL ON DATABASE $DATABASE_NAME FROM PUBLIC;
EOF

  start_differential_redis publish
  published_database=$(run_podman port "$PG_CONTAINER" 5432/tcp)
  PREFLIGHT_DATABASE_PORT=${published_database##*:}
  published_redis=$(run_podman port "$REDIS_CONTAINER" 6379/tcp)
  PREFLIGHT_REDIS_PORT=${published_redis##*:}
  case "$PREFLIGHT_DATABASE_PORT:$PREFLIGHT_REDIS_PORT" in
    *[!0-9:]*|:|*:*:) die 'invalid cutover fixture endpoint' ;;
  esac
  reader_url="postgresql://$DATABASE_READER:$DATABASE_READER_PASSWORD@127.0.0.1:$PREFLIGHT_DATABASE_PORT/$DATABASE_NAME"
  migrator_url="postgresql://$OPERATIONAL_MIGRATOR:$OPERATIONAL_MIGRATOR_PASSWORD@127.0.0.1:$PREFLIGHT_DATABASE_PORT/$DATABASE_NAME"
  runtime_url="postgresql://$WORKER_RUNTIME:$WORKER_RUNTIME_PASSWORD@127.0.0.1:$PREFLIGHT_DATABASE_PORT/$DATABASE_NAME"
  writer_url="postgresql://$DIFFERENTIAL_WRITER:$DIFFERENTIAL_WRITER_PASSWORD@127.0.0.1:$PREFLIGHT_DATABASE_PORT/$DATABASE_NAME"
