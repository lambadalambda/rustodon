# A stale filter must not turn a missing regression into a successful zero-test run.
require_ignored_tests() {
  selection=$1; shift
  case "$selection" in
    exact) listing=$(cargo test --locked "$@" -- --ignored --list --exact) || return $? ;;
    group) listing=$(cargo test --locked "$@" -- --ignored --list) || return $? ;;
    *) die 'invalid ignored-test selection mode' ;;
  esac
  printf '%s\n' "$listing" | grep -Eq '^.+: test$' ||
    die 'selected ignored tests are missing; refusing an empty integration pass'
}

schema_read_rust_test() {
  case "$1" in
    batch_accounts) set -- --features test-support --lib web::batch_accounts_tests ;;
    v2_account_search) set -- --features test-support --lib web::account_search_tests ;;
    api_empty_reads) set -- --features test-support --lib web::api_empty_reads_tests ;;
    web_settings) set -- --features test-support --lib web::web_settings_tests ;;
    media_proxy) set -- --features test-support --lib web::cached_media_response_tests::cached_private_media_http_requires_status_access_even_when_files_exist ;;
    account_stats_repair) set -- --features test-support --test account_stats_repair ;;
    mastodon_schema) set -- --features test-support --test mastodon_schema ;;
    saved_status_authorization|qualified_local_mentions|followed_hashtag_streams|public_oauth_revocation|oauth_response_modes|media_state)
      set -- --test "$1" ;;
    *) die "unknown schema-read test: $1" ;;
  esac
  require_ignored_tests group "$@" || return $?
  cargo test --locked "$@" -- --ignored --nocapture --test-threads=1
}

