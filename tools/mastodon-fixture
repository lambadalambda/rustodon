generate_fixture() {
  output=${1:-$FIXTURE_DIR}
  case "$output" in
    "$FIXTURE_DIR") ;;
    "$ROOT"/target/mastodon-v4.6.5-*) ;;
    *) die 'refusing unsupported fixture destination or override' ;;
  esac

  verify_source "$SOURCE_DIR" >/dev/null
  need_command sha256sum
  need_command cmp
  need_command podman

  stage="$ROOT/target/mastodon-v4.6.5-stage-$$"
  rm -rf "$stage"
  mkdir -p "$stage/media-source" "$stage/media"

  for input in README.md seed.sql catalog-query.sql process-media.rb verify.sql verify.rb
  do
    cp "$FIXTURE_DIR/$input" "$stage/$input"
  done
  git -C "$SOURCE_DIR" show "$REVISION:spec/fixtures/files/emojo.png" > "$stage/media-source/avatar.png"
  git -C "$SOURCE_DIR" show "$REVISION:spec/fixtures/files/attachment.jpg" > "$stage/media-source/status.jpg"
  [ "$(file_sha256 "$stage/media-source/avatar.png")" = '0112603425bb49c1f6a453f1d35678919b61aa1b020f5b18a99cdfc83b12f5bb' ] ||
    die 'published Mastodon avatar Git blob hash mismatch'
  [ "$(file_sha256 "$stage/media-source/status.jpg")" = 'cd63911ad76f4d5dd509c4d73bf3640d6ea7183337f3032ef96fd705309c3845' ] ||
    die 'published Mastodon status image Git blob hash mismatch'

  verify_images
  start_database
  run_rails "$stage" 'bundle exec rails db:schema:load'

  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    < "$stage/seed.sql" >/dev/null
  run_rails_writable "$stage" 'bundle exec rails runner /fixture/process-media.rb'
  rm -rf "$stage/media-source"

  write_migrations_manifest "$SOURCE_DIR" "$stage/migrations.tsv" "$stage/expected-migrations.txt"
  run_podman exec "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --tuples-only --no-align \
    --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    --command 'SELECT version FROM schema_migrations ORDER BY version' \
    > "$stage/applied-migrations.txt"
  if ! cmp -s "$stage/expected-migrations.txt" "$stage/applied-migrations.txt"; then
    die 'loaded schema migration rows do not match the complete pinned source migration list'
  fi
  actual_migration_count=$(wc -l < "$stage/expected-migrations.txt" | tr -d ' ')
  if [ "$actual_migration_count" != "$MIGRATION_COUNT" ]; then
    die "migration count mismatch: expected $MIGRATION_COUNT, got $actual_migration_count"
  fi
  rm "$stage/expected-migrations.txt" "$stage/applied-migrations.txt"

  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --tuples-only --no-align \
    --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    < "$stage/catalog-query.sql" > "$stage/catalog.txt"

  run_podman exec --env LC_ALL=C "$PG_CONTAINER" pg_dump \
    --format=plain --encoding=UTF8 --no-owner --no-privileges --no-comments \
    --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    > "$stage/database.raw.sql"
  sed \
    -e 's/^\\restrict .*/\\restrict rustodonMastodon465FixtureDump/' \
    -e 's/^\\unrestrict .*/\\unrestrict rustodonMastodon465FixtureDump/' \
    "$stage/database.raw.sql" |
    awk '
      { lines[NR] = $0 }
      length($0) > 0 { last_content_line = NR }
      END {
        for (line_number = 1; line_number <= last_content_line; line_number++) {
          print lines[line_number]
        }
      }
    ' > "$stage/database.sql"
  rm "$stage/database.raw.sql"
  finish_database

  write_manifest "$stage"
  (
    cd "$stage"
    sha256sum \
      README.md \
      catalog-query.sql \
      catalog.txt \
      database.sql \
      manifest.json \
      migrations.tsv \
      process-media.rb \
      seed.sql \
      verify.rb \
      verify.sql \
      media/accounts/avatars/116/844/606/259/201/001/original/0112603425bb49c1.png \
      media/media_attachments/files/116/844/842/188/806/001/original/cd63911ad76f4d5d.jpg \
      media/media_attachments/files/116/844/842/188/806/001/small/cd63911ad76f4d5d.jpg \
      > SHA256SUMS
  )
  chmod -R u=rwX,go=rX "$stage"

  rm -rf "$output"
  mv "$stage" "$output"
  printf 'generated deterministic Mastodon %s fixture at %s\n' "$RELEASE" "$output"
}

require_manifest_value() {
  manifest=$1
  value=$2
  grep -F "$value" "$manifest" >/dev/null 2>&1 ||
    die "manifest baseline mismatch: missing $value"
}

verify_static() {
  fixture=${1:-$FIXTURE_DIR}
  manifest="$fixture/manifest.json"
  [ -f "$manifest" ] || die "fixture manifest not found: $manifest"
  [ -f "$fixture/SHA256SUMS" ] || die "fixture checksums not found: $fixture/SHA256SUMS"

  require_manifest_value "$manifest" '"release": "v4.6.5"'
  require_manifest_value "$manifest" "\"revision\": \"$REVISION\""
  require_manifest_value "$manifest" "\"schema_version\": \"$SCHEMA_VERSION\""
  require_manifest_value "$manifest" "\"schema_sha256\": \"$SCHEMA_SHA256\""
  require_manifest_value "$manifest" "\"platform\": \"$PLATFORM\""
  require_manifest_value "$manifest" "\"mastodon_image\": \"$MASTODON_INDEX_IMAGE\""
  require_manifest_value "$manifest" "\"postgres_image\": \"$POSTGRES_INDEX_IMAGE\""
  require_manifest_value "$manifest" "\"manifest_digest\": \"$MASTODON_MANIFEST_DIGEST\""
  require_manifest_value "$manifest" "\"manifest_digest\": \"$POSTGRES_MANIFEST_DIGEST\""
  require_manifest_value "$manifest" "\"database_name\": \"$DATABASE_NAME\""
  require_manifest_value "$manifest" "\"local_domain\": \"$LOCAL_DOMAIN\""

  checksum_output=$(cd "$fixture" && sha256sum --check SHA256SUMS 2>&1) ||
    die "checksum mismatch in $fixture: $checksum_output"

  migration_lines=$(wc -l < "$fixture/migrations.tsv" | tr -d ' ')
  [ "$migration_lines" = '589' ] ||
    die "migration manifest mismatch: expected 588 entries plus header, got $migration_lines lines"

  for kind in relation column constraint index view materialized_view sequence extension function
  do
    grep -F "${kind}$(printf '\t')" "$fixture/catalog.txt" >/dev/null 2>&1 ||
      die "catalog fingerprint is missing $kind entries"
  done

  for type in mention status reblog follow follow_request favourite poll update \
    severed_relationships moderation_warning annual_report admin.sign_up \
    admin.report quote quoted_update added_to_collection collection_update
  do
    require_manifest_value "$manifest" "\"notification.$type\""
  done

  printf 'verified static Mastodon %s fixture checksums and pinned metadata\n' "$RELEASE"
}

restore_verify() {
  fixture=${1:-$FIXTURE_DIR}
  verify_static "$fixture"
  verify_images
  start_database

  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    < "$fixture/database.sql" >/dev/null
  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    < "$fixture/verify.sql"

  restored_catalog="$ROOT/target/mastodon-v4.6.5-restored-catalog-$$.txt"
  run_podman exec -i "$PG_CONTAINER" psql \
    --set ON_ERROR_STOP=1 --tuples-only --no-align \
    --username "$DATABASE_USER" --dbname "$DATABASE_NAME" \
    < "$fixture/catalog-query.sql" > "$restored_catalog"
  if ! cmp -s "$fixture/catalog.txt" "$restored_catalog"; then
    die "restored catalog fingerprint mismatch; inspect $restored_catalog"
  fi
  rm "$restored_catalog"

  run_rails "$fixture" 'bundle exec rails runner /fixture/verify.rb'
  finish_database
  printf 'restored and verified Mastodon %s fixture with Rails\n' "$RELEASE"
}

reproducibility_check() {
  verify_static "$FIXTURE_DIR"
  candidate="$ROOT/target/mastodon-v4.6.5-repro-$$"
  generate_fixture "$candidate"
  verify_static "$candidate"
  if ! diff -r "$FIXTURE_DIR" "$candidate" >/dev/null; then
    die "byte-for-byte reproducibility mismatch; inspect $candidate"
  fi
  rm -rf "$candidate"
  printf 'byte-for-byte reproducibility check passed for Mastodon %s\n' "$RELEASE"
}

usage() {
  cat <<'EOF'
Usage: tools/mastodon-fixture COMMAND [PATH]

Commands:
  safety                 Print the hard-coded fixture database and domains
  obtain [PATH]          Obtain and verify the pinned Mastodon source
  verify-source PATH     Verify source tag, revision, schema version, and hash
  generate [PATH]        Generate artifacts (default: checked fixture path)
  verify [PATH]          Verify pinned metadata and artifact checksums (fast)
  restore-verify [PATH]  Restore and verify with PostgreSQL and Mastodon Rails
  repro                   Regenerate and compare every fixture byte
EOF
}

command=${1:-}
if [ -n "$command" ]; then
  shift
fi

case "$command" in
  safety)
    [ "$#" -eq 0 ] || die 'safety takes no arguments'
    printf 'database=%s\ndomain=%s\nremote_domain=%s\n' "$DATABASE_NAME" "$LOCAL_DOMAIN" "$REMOTE_DOMAIN"
    ;;
  obtain)
    [ "$#" -le 1 ] || die 'obtain accepts at most one path'
    obtain_source "${1:-$SOURCE_DIR}"
    ;;
  verify-source)
    [ "$#" -eq 1 ] || die 'verify-source requires exactly one path'
    verify_source "$1"
    ;;
  generate)
    [ "$#" -le 1 ] || die 'refusing unsupported fixture destination or override'
    generate_fixture "${1:-$FIXTURE_DIR}"
    ;;
  verify)
    [ "$#" -le 1 ] || die 'verify accepts at most one path'
    verify_static "${1:-$FIXTURE_DIR}"
    ;;
  restore-verify)
    [ "$#" -le 1 ] || die 'restore-verify accepts at most one path'
    restore_verify "${1:-$FIXTURE_DIR}"
    ;;
  repro)
    [ "$#" -eq 0 ] || die 'repro takes no arguments'
    reproducibility_check
    ;;
  help|-h|--help)
    usage
    ;;
  '')
    usage >&2
    exit 2
    ;;
  *)
    usage >&2
    die "unknown command: $command"
    ;;
esac
