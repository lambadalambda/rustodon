#!/usr/bin/env python3
"""Verify the small vendored worker corpus, independently of upstream source checks."""
import hashlib
import pathlib
import sys

EXPECTED = {
    "attachment.gif": "8241329ebbe0c8fb87acb3432fa166d07fe2f122afa14000bc84e142d82bd5f1",
    "attachment.jpg": "cd63911ad76f4d5dd509c4d73bf3640d6ea7183337f3032ef96fd705309c3845",
    "avatar.gif": "d2562762b0ff220aafd128e6b266fa3f172eb4a92c0dcb584e0b28e8618d7d2e",
}


def verify(directory):
    manifest = directory.joinpath("SHA256SUMS").read_text().splitlines()
    expected_manifest = [f"{digest}  {name}" for name, digest in EXPECTED.items()]
    if sorted(manifest) != sorted(expected_manifest):
        raise ValueError("SHA256SUMS must contain exactly the three pinned worker assets")
    for name, digest in EXPECTED.items():
        if hashlib.sha256(directory.joinpath(name).read_bytes()).hexdigest() != digest:
            raise ValueError(f"checksum mismatch: {name}")


if __name__ == "__main__":
    if len(sys.argv) > 2:
        sys.exit("usage: verify-worker-media [fixture-directory]")
    directory = (pathlib.Path(sys.argv[1]) if len(sys.argv) == 2 else
                 pathlib.Path(__file__).resolve().parent.parent /
                 "fixtures/worker-media/mastodon-v4.6.5")
    try:
        verify(directory)
    except (OSError, ValueError) as error:
        sys.exit(f"worker media prerequisite failed in {directory}: {error}")
    print("pinned worker media verified (3 assets)")
