#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -P -- "$(dirname -- "$0")/../.." && pwd)
test_root=$(mktemp -d "${TMPDIR:-/tmp}/rustodon-browser-smoke-test.XXXXXX")
trap 'rm -rf "$test_root"' EXIT HUP INT TERM
mkdir -p "$test_root/bin" "$test_root/js"

# Validate deadline wiring without waiting for real timeouts in offline tests.
cat > "$test_root/bin/timeout" <<'EOF'
#!/bin/sh
set -eu
[ "$#" -ge 4 ] && [ "$1" = --kill-after=5 ] && [ "$2" = 20 ] && [ "$3" = agent-browser ] || exit 76
shift 2
export BROWSER_TEST_BOUNDED=true
exec "$@"
EOF

cat > "$test_root/bin/agent-browser" <<'EOF'
#!/bin/sh
set -eu
[ "${BROWSER_TEST_BOUNDED:-false}" = true ] || exit 76
# Semantic eval checkpoints keep this offline test independent of the installed
# CLI's network envelope. They test shell sequencing/fail-closed handling, NOT
# the JavaScript predicates, real debounce timing, or response allowlisting.
# Parent must verify those in the authorized environment with the installed CLI
# skill and real fixture.
printf '%s\n' "$*" >> "$BROWSER_TEST_COMMANDS"
# Model the verified 0.31.1 invocation, rather than silently accepting arbitrary
# global flags. Every browser operation, including cleanup, owns one run session.
case "$*" in
  'session id --scope worktree --prefix rustodon-browser') ;;
  *)
    [ "$#" -ge 5 ] && [ "$1" = --session ] && [ "$3" = --args ] &&
      [ "$4" = "$BROWSER_TEST_EXPECTED_ARGS" ] || {
        printf '%s\n' 'unsupported or missing browser isolation arguments' >&2
        exit 73
      }
    case "$5" in
      open|pushstate)
        if [ "${6:-}" != --init-script ]; then
          case "${6:-}" in
            "$BROWSER_TEST_BASE_URL"|"$BROWSER_TEST_BASE_URL/"*) ;;
            *) printf '%s\n' 'navigation must retain the fixture origin and protocol' >&2; exit 90 ;;
          esac
        fi
        ;;
      cookies)
        if [ "${6:-}" = set ]; then
          [ "$#" -eq 12 ] && [ "$9" = --url ] && [ "${10}" = "$BROWSER_TEST_BASE_URL/" ] &&
            [ "${11}" = --path ] && [ "${12}" = / ] || exit 91
        fi
        ;;
    esac
    case "$2" in
      test-session-*)
        run_id=${2#test-session-}
        case "$run_id" in ''|*[!0-9]*) exit 74 ;; esac
        ;;
      *) printf '%s\n' 'expected a run-specific session' >&2; exit 74 ;;
    esac
    if [ -f "$BROWSER_TEST_SESSION" ]; then
      [ "$(cat "$BROWSER_TEST_SESSION")" = "$2" ] || exit 75
    else
      printf '%s\n' "$2" > "$BROWSER_TEST_SESSION"
    fi
    if [ "$5" = open ] && [ "${6:-}" = --init-script ]; then
      [ "$#" -eq 7 ] && [ ! -e "$BROWSER_TEST_SESSION.init" ] || exit 77
      [ -f "$7" ] && [ "$(stat -c '%a' "$7")" = 600 ] || exit 78
      printf '%s\n' "$7" > "$BROWSER_TEST_SESSION.init"
      if [ "${BROWSER_TEST_CAPTURE_JS:-false}" = true ]; then
        cp "$7" "$BROWSER_TEST_JS/api-init.js"
      fi
    elif [ "$5" != close ]; then
      # The init script must be staged once, before any operation can navigate.
      [ -s "$BROWSER_TEST_SESSION.init" ] || exit 79
    fi
    ;;
esac
case "$*" in
  *' wait --load '*) printf '%s\n' 'load-state waiting is not DOM readiness' >&2; exit 80 ;;
esac
# Inject CLI failures without launching or sleeping. Exit 124 models timeout's
# result, not a real timed browser process.
case "${BROWSER_TEST_FAIL_AT:-}:$*" in
  command-session-id:'session id --scope worktree --prefix rustodon-browser'|\
  command-network:*' network requests --clear'|\
  command-open:*' open '*|\
  command-navigation:*' open http://fixture.invalid:18080/'|\
  command-wait:*' wait '*|\
  command-close:*' close'|\
  command-network-close:*' network requests --clear') exit 124 ;;
  command-network-close:*' close') exit 72 ;;
esac
# Capture expanded eval payloads from the happy path for Node syntax checks.
# Do not execute browser JavaScript here or retain any non-fixture data.
if [ "${BROWSER_TEST_CAPTURE_JS:-false}" = true ]; then
  case "$*" in
    *' eval '*)
      (
        while [ "$1" != eval ]; do shift; done
        shift
        js_file=$(mktemp "$BROWSER_TEST_JS/eval.XXXXXX")
        printf '%s\n' "$1" > "$js_file"
      )
      ;;
    *' wait --fn '*)
      (
        while [ "$1" != --fn ]; do shift; done
        shift
        js_file=$(mktemp "$BROWSER_TEST_JS/ready.XXXXXX")
        printf '%s\n' "$1" > "$js_file"
      )
      ;;
  esac
fi
case "$*" in
  *' eval '*rustodon-smoke:*)
    checkpoint=$(printf '%s\n' "$*" | sed -n 's/.*\/\* rustodon-smoke: \([a-z-]*\) \*\/.*/\1/p')
    case "$checkpoint" in
      api-observer-ready|settings-ui-ready|settings-leading-observed|settings-trailing-observed|settings-reload-persisted|api-responses-acceptable) ;;
      *) printf 'unknown smoke checkpoint: %s\n' "$checkpoint" >&2; exit 71 ;;
    esac
    printf '%s\n' "$checkpoint" >> "$BROWSER_TEST_EVENTS"
    if [ "$checkpoint" = "${BROWSER_TEST_FAIL_AT:-}" ]; then
      case "${BROWSER_TEST_RESULT:-false}" in
        empty) ;;
        command-error) exit 72 ;;
        *) printf '%s\n' "$BROWSER_TEST_RESULT" ;;
      esac
    else
      printf '%s\n' true
    fi
    ;;
  *' eval '*settingsResourceCount*)
    if [ "${BROWSER_TEST_RESULT:-}" = diagnostic-error ]; then exit 73; fi
    printf '%s\n' '{"statePresent":true,"changeCount":1,"requestCount":0,"settingsResourceCount":0}'
    ;;
  *' eval '*distinctFailedRoutes*)
    if [ "${BROWSER_TEST_FAIL_AT:-}" = authenticated-api ] && [ "${BROWSER_TEST_RESULT:-}" = diagnostic-error ]; then exit 73; fi
    printf '%s\n' '{"failedRoutes":[{"route":"/api/:unclassified","status":403,"crossOrigin":false,"count":1}]}'
    ;;
  *' eval '*'const watch = window.__rustodonApiSmoke;'*)
    if [ "${BROWSER_TEST_FAIL_AT:-}" = authenticated-api ] && [ -f "$BROWSER_TEST_SESSION.auth" ]; then
      if [ "${BROWSER_TEST_RESULT:-}" = command-error ]; then exit 72; fi
      printf '%s\n' false
    else
      printf '%s\n' true
    fi
    ;;
  *' click label[for="setting-toggle-home_timeline-shows-reblog"]')
    printf '%s\n' toggle-boosts >> "$BROWSER_TEST_EVENTS" ;;
  *' click label[for="setting-toggle-home_timeline-shows-reply"]')
    printf '%s\n' toggle-replies >> "$BROWSER_TEST_EVENTS" ;;
  *' reload') printf '%s\n' reload >> "$BROWSER_TEST_EVENTS" ;;
  *' click '*) ;;
  'session id --scope worktree --prefix rustodon-browser') printf '%s\n' test-session ;;
  *' get count #mastodon') printf '%s\n' 1 ;;
  *' eval document.body.className') printf '%s\n' app-body ;;
  *' eval '*initial-state*'116844606259201001'*)
    : > "$BROWSER_TEST_SESSION.auth"
    printf '%s\n' true
    ;;
  *' eval '*initial-state*) printf '%s\n' true ;;
  *' eval '*) printf '%s\n' true ;;
  *' get text '*) printf '%s\n' 'Profile details Save changes' ;;
  *' get url') printf '%s/about\n' "$BROWSER_TEST_BASE_URL" ;;
  *' errors'*) printf '%s\n' 'No page errors' ;;
  *' network requests'*) ;;
  *' open http://fixture.invalid:18080/settings/profile'|*' open https://fixture.invalid:18443/settings/profile')
    printf '%s\n' profile-settings >> "$BROWSER_TEST_EVENTS" ;;
  *' open '*) ;;
  *' wait '*) ;;
  *' fill '*) printf '%s\n' fixture-password ;;
  *' cookies '*) ;;
  *' pushstate '*) ;;
  *' close') ;;
  *) printf 'unexpected agent-browser command: %s\n' "$*" >&2; exit 70 ;;
esac
EOF

cat > "$test_root/bin/curl" <<'EOF'
#!/bin/sh
set -eu
# Verify trust argument wiring, not TLS itself. Parent's real HTTPS fixture must
# separately prove CA/hostname verification and the exact installed CLI parser.
printf '%s\n' called >> "$BROWSER_TEST_CURL_CALLS"
case "$BROWSER_TEST_BASE_URL" in
  https://*)
    # Suppress ambient .curlrc: it could otherwise enable insecure verification.
    [ "${1:-}" = --disable ] || [ "${1:-}" = -q ] || exit 86
    ;;
esac
ca_count=0
url_count=0
ca_file=''
dump_header=''
output=''
cookie=''
data=''
url=''
while [ "$#" -gt 0 ]; do
  case "$1" in
    --dump-header) dump_header=$2; shift 2 ;;
    --output) output=$2; shift 2 ;;
    --cookie) cookie=$2; shift 2 ;;
    --data-urlencode)
      case "$2" in csrf_token=*) data=$2 ;; esac
      shift 2
      ;;
    http://*|https://*) url_count=$((url_count + 1)); url=$1; shift ;;
    --cacert) ca_count=$((ca_count + 1)); ca_file=$2; shift 2 ;;
    --resolve|--header|--cookie-jar|--write-out|--max-time) shift 2 ;;
    --disable|-q|--silent|--show-error|--fail) shift ;;
    *) printf '%s\n' 'unexpected curl option (TLS bypass is forbidden)' >&2; exit 87 ;;
  esac
done
[ "$url_count" -eq 1 ] || exit 89
case "$url" in "$BROWSER_TEST_BASE_URL/"*) ;; *) exit 89 ;; esac
case "$BROWSER_TEST_BASE_URL" in
  https://*)
    [ "$ca_count" -eq 1 ] && [ "$ca_file" = "$BROWSER_TEST_EXPECTED_CA" ] || exit 88
    if [ "${BROWSER_TEST_FAIL_AT:-}" = curl-tls ]; then exit 60; fi
    ;;
  *) [ "$ca_count" -eq 0 ] || exit 88 ;;
esac

case "$url:$dump_header:$data" in
  */auth/sign_in:?*:)
    printf '%s\n' csrf-sign-in >> "$BROWSER_TEST_EVENTS"
    printf '%s\n' 'Set-Cookie: __Host-csrf_token=sign-in-cookie; Path=/; Secure; HttpOnly' > "$dump_header"
    printf '%s\n' '<input type="hidden" name="csrf_token" value="sign-in-rendered">' > "$output"
    ;;
  */auth/sign_in:?*:csrf_token=sign-in-rendered)
    printf '%s\n' sign-in >> "$BROWSER_TEST_EVENTS"
    [ "$cookie" = '__Host-csrf_token=sign-in-cookie' ] || exit 81
    printf '%s\n' 'Set-Cookie: _mastodon_session=browser-session; Path=/; HttpOnly' > "$dump_header"
    printf '%s\n' '302|https://fixture.invalid/'
    ;;
  */settings/profile:?*:)
    printf '%s\n' csrf-logout >> "$BROWSER_TEST_EVENTS"
    [ "$cookie" = '_mastodon_session=browser-session' ] || exit 82
    printf '%s\n' 'Set-Cookie: __Host-csrf_token=logout-cookie; Path=/; Secure; HttpOnly' > "$dump_header"
    printf '%s\n' '<input type="hidden" name="csrf_token" value="logout-rendered">' > "$output"
    ;;
  */auth/sign_out::csrf_token=logout-rendered)
    printf '%s\n' sign-out >> "$BROWSER_TEST_EVENTS"
    [ "$cookie" = '__Host-csrf_token=logout-cookie; _mastodon_session=browser-session' ] || exit 83
    printf '%s\n' 302
    ;;
  */settings/profile::)
    printf '%s\n' logout-probe >> "$BROWSER_TEST_EVENTS"
    [ "$cookie" = '_mastodon_session=browser-session' ] || exit 84
    printf '%s\n' '302|https://fixture.invalid/auth/sign_in'
    ;;
  *) exit 85 ;;
esac
EOF

chmod +x "$test_root/bin/agent-browser" "$test_root/bin/curl" "$test_root/bin/timeout"
failures=0

fail_test() {
  printf 'FAIL: %s\n' "$1" >&2
  failures=$((failures + 1))
}

run_smoke() {
  case_name=$1
  fail_at=$2
  result=$3
  auth=$4
  test_base_url=${5:-http://fixture.invalid:18080}
  test_host=${6:-fixture.invalid}
  test_ca=${7:-}
  test_spki=${8:-}
  expected_browser_args='--host-resolver-rules=MAP fixture.invalid 127.0.0.1'
  case "$test_base_url" in
    https://*) expected_browser_args="$expected_browser_args,--ignore-certificate-errors-spki-list=$test_spki" ;;
  esac
  email=''
  password=''
  otp=''
  if [ "$auth" = true ]; then
    email=alice@fixture.invalid
    password=fixture-password
    otp=fixture-otp
  fi
  events="$test_root/$case_name.events"
  commands="$test_root/$case_name.commands"
  output="$test_root/$case_name.output"
  curl_calls="$test_root/$case_name.curl-calls"
  : > "$events"
  : > "$commands"
  : > "$curl_calls"
  status=0
  capture_js=false
  [ "$case_name" != authenticated ] || capture_js=true
  PATH="$test_root/bin:$PATH" \
    BROWSER_TEST_BOUNDED=false \
    BROWSER_TEST_CAPTURE_JS="$capture_js" \
    BROWSER_TEST_JS="$test_root/js" \
    BROWSER_TEST_EVENTS="$events" \
    BROWSER_TEST_COMMANDS="$commands" \
    BROWSER_TEST_SESSION="$test_root/$case_name.session" \
    BROWSER_TEST_FAIL_AT="$fail_at" \
    BROWSER_TEST_RESULT="$result" \
    BROWSER_TEST_BASE_URL="$test_base_url" \
    BROWSER_TEST_EXPECTED_ARGS="$expected_browser_args" \
    BROWSER_TEST_EXPECTED_CA="$test_ca" \
    BROWSER_TEST_CURL_CALLS="$curl_calls" \
    RUSTODON_BROWSER_CA_FILE="$test_ca" \
    RUSTODON_BROWSER_SPKI="$test_spki" \
    RUSTODON_BROWSER_AUTH="$auth" \
    RUSTODON_BROWSER_EMAIL="$email" \
    RUSTODON_BROWSER_PASSWORD="$password" \
    RUSTODON_BROWSER_OTP="$otp" \
    RUSTODON_BROWSER_DEBUG=false \
    RUSTODON_BROWSER_RECORD='' \
    RUSTODON_BROWSER_SCREENSHOT='' \
    "$ROOT/tools/rustodon-browser-smoke" \
    "$test_base_url" "$test_host" > "$output" 2>&1 || status=$?
}

assert_cleanup() {
  session_file="$test_root/$case_name.session"
  if [ ! -s "$session_file" ]; then
    fail_test "$case_name: no valid run-specific browser session"
    return
  fi
  expected_close="--session $(cat "$session_file") --args $expected_browser_args close"
  grep -Fxq -- "$expected_close" "$commands" || fail_test "$case_name: owned browser session was not closed"
  if [ ! -s "$session_file.init" ]; then
    fail_test "$case_name: no staged init script"
  elif [ -e "$(cat "$session_file.init")" ]; then
    fail_test "$case_name: init script was not removed during cleanup"
  fi
}

# Keep the original CSRF/login/profile/logout curl contract above. No direct
# HTTP settings mutation is accepted by that mock; saving must be a UI action.
# api-responses-acceptable=true stands for successful API responses AND narrowly
# expected auth/missing-resource outcomes, not blanket acceptance of 4xx errors.
run_smoke authenticated '' true true
[ "$status" -eq 0 ] || fail_test 'authenticated fixture flow failed'
grep -q 'browser web-client smoke passed' "$output" || fail_test 'success output missing'
cat > "$test_root/expected.events" <<'EOF'
api-observer-ready
csrf-sign-in
sign-in
settings-ui-ready
toggle-boosts
settings-leading-observed
toggle-replies
settings-trailing-observed
reload
settings-reload-persisted
profile-settings
csrf-logout
sign-out
logout-probe
api-responses-acceptable
EOF
if ! cmp -s "$test_root/expected.events" "$events"; then
  fail_test 'missing/incorrect ordered UI action, leading/trailing PUT, reload, or API observation flow'
  printf '%s\n' 'Expected checkpoints/actions:' >&2
  cat "$test_root/expected.events" >&2
  printf '%s\n' 'Actual checkpoints/actions:' >&2
  cat "$events" >&2
fi
assert_cleanup
for step in session-id network open wait-predicate eval fill cookies close; do
  grep -Fq "browser step: begin $step (limit 20s)" "$output" || fail_test "missing safe start diagnostic: $step"
  grep -Fq "browser step: end $step (exit 0)" "$output" || fail_test "missing safe completion diagnostic: $step"
done
if grep -Eq 'alice@fixture.invalid|fixture-password|fixture-otp|browser-session|sign-in-cookie|logout-cookie|sign-in-rendered|logout-rendered|__rustodonSettingsSmoke|host-resolver-rules' "$output"; then
  fail_test 'browser progress exposed credentials, cookies, form values, eval source, or launch arguments'
fi

# TLS adapter contract: parent confirmed this suite RED before implementation.
# CA bytes here are an opaque mock fixture, not a real certificate. Real trust,
# wrong-host rejection and Chromium SPKI behavior require authorized integration.
tls_url=https://fixture.invalid:18443
tls_ca="$test_root/fixture CA.pem"
printf '%s\n' 'opaque fixture CA for argument checks' > "$tls_ca"
tls_pin=$(printf '%043d=' 0 | tr '0' A)
tls_plus_pin=$(printf '%042d8=' 0 | tr '0' '+')
tls_slash_pin=$(printf '%042d8=' 0 | tr '0' '/')
for pin_case in standard plus slash; do
  case "$pin_case" in standard) pin=$tls_pin ;; plus) pin=$tls_plus_pin ;; slash) pin=$tls_slash_pin ;; esac
  run_smoke "tls-authenticated-$pin_case" '' true true "$tls_url" fixture.invalid "$tls_ca" "$pin"
  [ "$status" -eq 0 ] || fail_test "$case_name: valid scoped TLS adapter failed"
  cmp -s "$test_root/expected.events" "$events" || fail_test "$case_name: HTTPS lost the authenticated settings/logout flow"
  [ "$(wc -l < "$curl_calls" | tr -d ' ')" -eq 5 ] || fail_test "$case_name: must verify CA on all five curl calls"
  if grep -Fq "$pin" "$output" || grep -Fq "$tls_ca" "$output"; then
    fail_test "$case_name: TLS diagnostics exposed pin or CA path"
  fi
  assert_cleanup
done
run_smoke tls-anonymous '' true false "$tls_url" fixture.invalid "$tls_ca" "$tls_pin"
[ "$status" -eq 0 ] || fail_test "$case_name: anonymous scoped TLS adapter failed"
[ ! -s "$curl_calls" ] || fail_test "$case_name: anonymous flow unexpectedly used curl"
assert_cleanup

# A CA/hostname failure must stop before login POST; no insecure or HTTP retry.
run_smoke tls-curl-failure curl-tls true true "$tls_url" fixture.invalid "$tls_ca" "$tls_pin"
[ "$status" -ne 0 ] || fail_test "$case_name: certificate verification failure ignored"
[ "$(wc -l < "$curl_calls" | tr -d ' ')" -eq 1 ] || fail_test "$case_name: curl trust failure retried or was not reached"
if grep -Eq '^(sign-in|settings-ui-ready)$' "$events" || grep -q 'browser web-client smoke passed' "$output"; then
  fail_test "$case_name: continued after certificate verification failure"
fi
assert_cleanup

reject_tls() {
  run_smoke "tls-reject-$1" '' true false "$2" "$3" "$4" "$5"
  [ "$status" -eq 1 ] || fail_test "$case_name: invalid TLS configuration must fail closed"
  [ ! -s "$commands" ] || fail_test "$case_name: rejected configuration reached browser discovery/launch"
  [ ! -s "$curl_calls" ] || fail_test "$case_name: rejected configuration reached curl"
  if [ -n "$4" ] && grep -Fq -- "$4" "$output"; then fail_test "$case_name: raw CA path in validation output"; fi
  if [ -n "$5" ] && grep -Fq -- "$5" "$output"; then fail_test "$case_name: raw pin in validation output"; fi
}
reject_tls missing-both "$tls_url" fixture.invalid '' ''
reject_tls missing-ca "$tls_url" fixture.invalid '' "$tls_pin"
reject_tls missing-pin "$tls_url" fixture.invalid "$tls_ca" ''
reject_tls absent-ca "$tls_url" fixture.invalid "$test_root/no-CA.pem" "$tls_pin"
: > "$test_root/empty-CA.pem"
reject_tls empty-ca "$tls_url" fixture.invalid "$test_root/empty-CA.pem" "$tls_pin"
reject_tls directory-ca "$tls_url" fixture.invalid "$test_root" "$tls_pin"
printf '%s\n' 'opaque fixture CA' > "$test_root/unreadable-CA.pem"
chmod 000 "$test_root/unreadable-CA.pem"
if [ ! -r "$test_root/unreadable-CA.pem" ]; then
  reject_tls unreadable-ca "$tls_url" fixture.invalid "$test_root/unreadable-CA.pem" "$tls_pin"
else
  printf '%s\n' 'SKIP: unreadable CA permission check (test user can still read mode 000)'
fi
chmod 600 "$test_root/unreadable-CA.pem"
for http_case in both ca pin; do
  ca=$tls_ca; pin=$tls_pin
  case "$http_case" in ca) pin='' ;; pin) ca='' ;; esac
  reject_tls "http-$http_case" http://fixture.invalid:18080 fixture.invalid "$ca" "$pin"
done
pin_index=0
for pin in 'synthetic-private-pin' "sha256/$tls_pin" "${tls_pin%=}" "$tls_pin=" \
  "${tls_pin%=}B=" "${tls_pin%=}?" "${tls_pin%??}B=" "$tls_pin,$tls_pin" \
  "$tls_pin,--ignore-certificate-errors" "$tls_pin --ignore-certificate-errors" \
  "$(printf '%s\r' "$tls_pin")" "$(printf '%s\t' "$tls_pin")" "$(printf '%s\nsynthetic-private-pin-tail' "$tls_pin")"; do
  pin_index=$((pin_index + 1))
  reject_tls "pin-$pin_index" "$tls_url" fixture.invalid "$tls_ca" "$pin"
done
# --args is comma-delimited: reject resolver-host injection before discovery too.
for host_case in comma space newline; do
  case "$host_case" in
    comma) bad_host='fixture.invalid,--ignore-certificate-errors' ;;
    space) bad_host='fixture.invalid --ignore-certificate-errors' ;;
    newline) bad_host=$(printf 'fixture.invalid\nx') ;;
  esac
  reject_tls "host-$host_case" "$tls_url" "$bad_host" "$tls_ca" "$tls_pin"
done

# A first-command launch failure must identify its boundary without relying on
# page output. Cleanup remains visible/bounded and must not mask the main error.
for step in session-id network open navigation wait close; do
  run_smoke "trace-$step" "command-$step" true true
  label=$step
  [ "$step" != navigation ] || label=open
  [ "$step" != wait ] || label=wait-predicate
  grep -Fq "browser step: begin $label (limit 20s)" "$output" || fail_test "$case_name: missing boundary start"
  grep -Fq "browser step: end $label (exit 124)" "$output" || fail_test "$case_name: missing timeout exit diagnostic"
  if [ "$step" = close ]; then
    [ "$status" -eq 0 ] || fail_test "$case_name: cleanup masked successful main result"
  else
    expected_status=124
    if [ "$step" = wait ]; then
      expected_status=1
      grep -Fq 'initial-app readiness failed' "$output" || fail_test "$case_name: missing readiness failure"
      grep -Fq 'browser API diagnostic:' "$output" || fail_test "$case_name: missing safe readiness diagnostic"
    fi
    [ "$status" -eq "$expected_status" ] || fail_test "$case_name: unexpected failure exit"
    if grep -q 'browser web-client smoke passed' "$output"; then
      fail_test "$case_name: launch/wait failure printed success"
    fi
  fi
  if [ "$step" != session-id ]; then assert_cleanup; fi
done

run_smoke trace-main-and-cleanup command-network-close true true
[ "$status" -eq 124 ] || fail_test 'cleanup failure replaced the main timeout status'
grep -Fq 'browser step: end network (exit 124)' "$output" || fail_test 'main failure diagnostic missing'
grep -Fq 'browser step: end close (exit 72)' "$output" || fail_test 'cleanup failure diagnostic missing'
assert_cleanup

# All observation gates must fail closed. A missing PUT, unsuccessful trailing
# save, stale reload, or unexpected API response must never print success.
# This deliberately remains a shell-level contract: the mock does not execute
# eval JavaScript or claim that true means any real response was inspected.
for checkpoint in api-observer-ready settings-ui-ready settings-leading-observed \
  settings-trailing-observed settings-reload-persisted api-responses-acceptable; do
  for result in false empty '"true"' malformed '{"success":true,"data":{"result":true}}' command-error; do
    run_smoke "$checkpoint-$result" "$checkpoint" "$result" true
    [ "$status" -ne 0 ] || fail_test "$case_name: rejected observation was ignored"
    if [ "$result" != command-error ]; then
      case "$result" in
        false) shape=boolean-false ;;
        empty) shape=empty ;;
        '"true"') shape=quoted-boolean ;;
        '{'*) shape=object-like ;;
        *) shape=other ;;
      esac
      grep -Fq "result=$shape" "$output" || fail_test "$case_name: missing safe result classification"
      case "$checkpoint" in
        api-observer-ready|api-responses-acceptable)
          grep -Fq 'browser API diagnostic:' "$output" || fail_test "$case_name: missing API diagnostic"
          ;;
      esac
      if grep -Fq "$result" "$output" && [ "$shape" = object-like ]; then
        fail_test "$case_name: raw eval envelope was dumped"
      fi
    else
      [ "$status" -eq 1 ] || fail_test "$case_name: evaluation failure exit changed"
      grep -Fq 'result=eval-error' "$output" || fail_test "$case_name: missing eval-error classification"
