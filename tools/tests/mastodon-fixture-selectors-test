#!/bin/sh
# Offline regression coverage for real selector dispatch and Cargo selection guards.
set -eu
repo=$(CDPATH= cd -P -- "$(dirname -- "$0")/../.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/rustodon-selectors.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
MASTODON_FIXTURE_LIBRARY=1
. "$repo/tools/mastodon-fixture"
ROOT=$repo
FIXTURE_DIR="$ROOT/fixtures/mastodon/v4.6.5"
sed -n '/^case "$command" in$/,$p' "$repo/tools/mastodon-fixture" > "$work/dispatch.sh"
# Real dispatch, but fixture provisioning is forbidden in this offline test.
schema_read_test() { printf '%s\n' "${2:-mastodon_schema}" >> "$work/selected"; }
worker_test() { printf '%s\n' "${1:-ALL}" >> "$work/worker-selected"; }
run_podman() { echo 'unexpected container operation' >&2; exit 80; }
dispatch() ( command=$1; shift; . "$work/dispatch.sh"; )
dispatch schema-read-test
cat > "$work/expected" <<'EOF'
mastodon_schema
quote_lifecycle
account_stats_repair
saved_status_authorization
qualified_local_mentions
followed_hashtag_streams
public_oauth_revocation
oauth_response_modes
v2_account_search
api_empty_reads
web_settings
media_proxy
media_state
batch_accounts
EOF
cmp "$work/expected" "$work/selected" || die 'default schema gate omits a required HTTP regression'
for selector in v2_account_search api_empty_reads web_settings media_proxy media_state batch_accounts quote_lifecycle; do
  : > "$work/selected"
  dispatch schema-read-test "$selector"
  [ "$(cat "$work/selected")" = "$selector" ] || die "wrong selector: $selector"
done
if dispatch schema-read-test unknown > "$work/error" 2>&1; then die 'unknown selector accepted'; fi
: > "$work/worker-selected"
dispatch worker-test quote_federation_lifecycle
[ "$(cat "$work/worker-selected")" = quote_federation_lifecycle ] || die 'wrong worker selector'
if dispatch worker-test one two > "$work/error" 2>&1; then die 'extra worker selector accepted'; fi

cargo_mode=present
cargo() {
  printf '%s\n' "$*" >> "$work/cargo"
  case "$*" in
    *--list*)
      [ "$cargo_mode" != list-error ] || return 7
      [ "$cargo_mode" != empty ] || return 0
      printf '%s\n' 'web::example::regression: test' '1 test, 0 benchmarks'
      ;;
    *) [ "$cargo_mode" != run-error ] || return 9 ;;
  esac
}
for pair in 'batch_accounts batch_accounts_tests' 'v2_account_search account_search_tests' 'api_empty_reads api_empty_reads_tests' 'web_settings web_settings_tests' 'media_proxy cached_media_response_tests::cached_private_media_http_requires_status_access_even_when_files_exist'; do
  set -- $pair
  : > "$work/cargo"
  schema_read_rust_test "$1"
  grep -F -- "--features test-support --lib web::$2" "$work/cargo" >/dev/null || die "incorrect library target: $1"
  [ "$(wc -l < "$work/cargo" | tr -d ' ')" = 2 ] || die 'expected list check then test execution'
done
: > "$work/cargo"
schema_read_rust_test media_state
grep -F -- '--test media_state' "$work/cargo" >/dev/null || die 'incorrect media-state target'
: > "$work/cargo"
worker_rust_test quote_federation_lifecycle
grep -F -- '--features test-support --test workers quote_lifecycle::quote_federation_lifecycle' "$work/cargo" >/dev/null || die 'incorrect quote worker target'
[ "$(wc -l < "$work/cargo" | tr -d ' ')" = 2 ] || die 'expected worker list check then exact execution'
if (worker_rust_test unknown) > "$work/error" 2>&1; then die 'unknown worker selector accepted'; fi
: > "$work/cargo"
schema_read_rust_test quote_lifecycle
grep -F -- '--features test-support --test quote_lifecycle' "$work/cargo" >/dev/null || die 'incorrect quote-lifecycle target'
: > "$work/cargo"
schema_read_rust_test account_stats_repair
grep -F -- '--features test-support --test account_stats_repair' "$work/cargo" >/dev/null || die 'incorrect account-stats-repair target'
for cargo_mode in empty list-error; do
  : > "$work/cargo"
  if (schema_read_rust_test web_settings) > "$work/error" 2>&1; then die "invalid selection succeeded: $cargo_mode"; fi
  [ "$(wc -l < "$work/cargo" | tr -d ' ')" = 1 ] || die 'test execution followed failed listing'
done
cargo_mode=run-error
if (schema_read_rust_test web_settings) > "$work/error" 2>&1; then die 'failed test was accepted'; fi
printf '%s\n' 'mastodon fixture selector and nonempty-selection tests passed'
