settings_setup_js=$(cat <<'JS'
/* rustodon-smoke: settings-ui-ready */
(async () => {
  // A settling allowance, not proof of an idle debounce: its saved/me guard
  // runs inside the callback, so even a no-PUT save invocation can arm it.
  const setupStartedAt = performance.now();
  await new Promise(resolve => setTimeout(resolve, 2100));
  const controls = ['reblog', 'reply'].map(key =>
    document.querySelectorAll('#setting-toggle-home_timeline-shows-' + key));
  if (controls.some(nodes => nodes.length !== 1 || nodes[0].disabled)) return false;
  const initial = controls.map(nodes => nodes[0].checked);
  const state = window.__rustodonSettingsSmoke = {
    initial, target: initial.map(value => !value), changes: [], requests: [],
    setupStartedAt, armedAt: performance.now(),
  };
  sessionStorage.setItem('rustodon-smoke-settings', JSON.stringify({
    target: state.target, document: performance.timeOrigin,
  }));
  // React derives checkbox onChange from click, before native change fires.
  // Capture the input click rather than the label click before React can start the PUT.
  document.addEventListener('click', event => {
    const index = controls.findIndex(nodes => nodes[0] === event.target);
    if (index !== -1) state.changes.push({ index, at: performance.now(), checked: event.target.checked });
  }, true);
  const originalOpen = XMLHttpRequest.prototype.open;
  const originalSend = XMLHttpRequest.prototype.send;
  const originalSetRequestHeader = XMLHttpRequest.prototype.setRequestHeader;
  const tracked = new WeakMap();
  XMLHttpRequest.prototype.open = function(method, url, ...args) {
    const parsed = new URL(url, location.href);
    if (parsed.origin === location.origin && parsed.pathname === '/api/web/settings') {
      tracked.set(this, { method: method.toUpperCase(), csrfHeaderPresent: false });
    } else {
      tracked.delete(this);
    }
    return originalOpen.call(this, method, url, ...args);
  };
  XMLHttpRequest.prototype.setRequestHeader = function(name, value) {
    // Observe only a successful setter; never retain, inject or replace values.
    const result = originalSetRequestHeader.call(this, name, value);
    const request = tracked.get(this);
    if (request && typeof name === 'string' && name.toLowerCase() === 'x-csrf-token') request.csrfHeaderPresent = true;
    return result;
  };
  XMLHttpRequest.prototype.send = function(body) {
    const request = tracked.get(this);
    if (request) {
      request.at = performance.now();
      request.csrfMetaTokenPresent = Boolean(document.querySelector('meta[name="csrf-token"]')?.content);
      try { request.body = JSON.parse(body); } catch { request.body = null; }
      state.requests.push(request);
      this.addEventListener('loadend', () => {
        request.status = this.status;
        // Exact public errors from src/web/web_settings.rs only. Unknown,
        // oversized or unreadable responses collapse to other; no raw retention.
        request.errorClass = 'other';
        try {
          let response;
          if (this.responseType === 'json') response = this.response;
          else if (!this.responseType || this.responseType === 'text') {
            const text = this.responseText;
            if (typeof text === 'string' && text.length <= 4096) response = JSON.parse(text);
          }
          switch (response?.error) {
            case "Can\u0027t verify CSRF token authenticity.": request.errorClass = 'csrf'; break;
            case 'This method requires an authenticated user': request.errorClass = 'user'; break;
            case 'data must be an object': request.errorClass = 'data'; break;
          }
        } catch { /* Diagnostic parsing must not interrupt completion tracking. */ }
        // Yield a task after Axios completion microtasks/SETTING_SAVE dispatch.
        setTimeout(() => { request.doneAt = performance.now(); request.done = true; }, 0);
      }, { once: true });
    }
    return originalSend.call(this, body);
  };
  return true;
})()
