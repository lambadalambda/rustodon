settings_contract_js=$(cat <<'JS'
const validSave = (request, values) => {
  const data = request?.body?.data;
  return request?.done === true && request.method === 'PUT' && request.status === 200 &&
    data !== null && typeof data === 'object' && !Object.hasOwn(data, 'saved') &&
    data.home?.shows?.reblog === values[0] && data.home?.shows?.reply === values[1];
};
const validLeading = state => {
  const change = state.changes[0];
  const request = state.requests[0];
  return state.changes.length === 1 && state.requests.length === 1 &&
    change.index === 0 && change.checked === state.target[0] &&
    request.at >= change.at && request.at - change.at < 500 &&
    validSave(request, [state.target[0], state.initial[1]]);
};
const validTrailing = state => {
  const [first, second] = state.changes;
  const [leading, trailing] = state.requests;
  return state.changes.length === 2 && state.requests.length === 2 &&
    first.index === 0 && first.checked === state.target[0] &&
    second.index === 1 && second.checked === state.target[1] &&
    second.at > first.at && second.at > leading.doneAt && second.at - first.at < 1800 &&
    leading.at >= first.at && leading.at - first.at < 500 &&
    trailing.at - second.at >= 1900 && trailing.at - second.at < 6000 &&
    validSave(leading, [state.target[0], state.initial[1]]) && validSave(trailing, state.target);
};
JS
)

