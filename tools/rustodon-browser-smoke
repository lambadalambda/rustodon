#!/bin/sh
set -eu

usage() {
    printf '%s\n' \
        'Usage: tools/rustodon-browser-smoke BASE_URL HOST' \
        '' \
        'BASE_URL must be the local Rustodon web origin.' \
        'HOST is the configured Rustodon LOCAL_DOMAIN.' \
        'HTTPS requires RUSTODON_BROWSER_CA_FILE (readable nonempty CA PEM file)' \
        'and RUSTODON_BROWSER_SPKI (one bare canonical base64 SHA-256 SPKI pin).' \
        'HTTP requires both trust variables to be absent or empty.' \
        'RUSTODON_BROWSER_AUTH=true enables the fixture server-authenticated browser-shell flow.' \
        'RUSTODON_BROWSER_EMAIL, _PASSWORD, and _OTP provide its test credentials.' \
        'RUSTODON_BROWSER_VOTER_EMAIL, _VOTER_PASSWORD, and _VOTER_OTP provide a second account for poll voting.' \
        'RUSTODON_BROWSER_POLL_STATUS_FILE may capture the generated fixture status ID for exact cleanup.' \
        'RUSTODON_BROWSER_RECORD may name a WebM recording path.' \
        'RUSTODON_BROWSER_SCREENSHOT may name a PNG screenshot path.'
}

fail() {
    printf 'browser smoke failed: %s\n' "$1" >&2
    exit 1
}

if [ "$#" -eq 1 ] && [ "$1" = '--help' ]; then
    usage
    exit 0
fi

[ "$#" -eq 2 ] || {
    usage >&2
    exit 2
}

base_url=${1%/}
host=$2
auth=${RUSTODON_BROWSER_AUTH:-false}
poll_status_file=${RUSTODON_BROWSER_POLL_STATUS_FILE:-}
cookie_jar=''
header_file=''
csrf_body=''
init_script=''
case "$base_url" in
    http://*|https://*) ;;
    *) fail 'BASE_URL must use http or https' ;;
esac
base_authority=${base_url#*://}
case "$base_authority" in
    ''|*'/'*|*'?'*|*'#'*|*'@'*)
        fail 'BASE_URL must be an origin without a path, query, fragment, or user info'
        ;;
esac
case "$host" in
    ''|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.:-]*)
        fail 'HOST must be a DNS authority without whitespace or argument delimiters'
        ;;
esac

browser_ca=${RUSTODON_BROWSER_CA_FILE:-}
browser_spki=${RUSTODON_BROWSER_SPKI:-}
case "$base_url" in
    https://*)
        [ -n "$browser_ca" ] && [ -f "$browser_ca" ] && [ -r "$browser_ca" ] && [ -s "$browser_ca" ] ||
            fail 'HTTPS requires RUSTODON_BROWSER_CA_FILE to be a readable nonempty regular CA PEM file'
        # SHA-256 is 32 bytes: 43 base64 symbols plus one padding character.
        # The final symbol has two zero pad bits; reject lists and CLI injection.
        [ "${#browser_spki}" -eq 44 ] || fail 'RUSTODON_BROWSER_SPKI must be one canonical SHA-256 base64 pin'
        case "$browser_spki" in
            *[AEIMQUYcgkosw048]=) ;;
            *) fail 'RUSTODON_BROWSER_SPKI must be one canonical SHA-256 base64 pin' ;;
        esac
        case "${browser_spki%=}" in
            *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/]*)
                fail 'RUSTODON_BROWSER_SPKI must be one canonical SHA-256 base64 pin' ;;
        esac
        ;;
    http://*)
        [ -z "$browser_ca" ] && [ -z "$browser_spki" ] ||
            fail 'browser trust variables require an HTTPS BASE_URL'
        ;;
esac
case "$auth" in
    false) ;;
    true)
        browser_email=${RUSTODON_BROWSER_EMAIL:-}
        browser_password=${RUSTODON_BROWSER_PASSWORD:-}
        browser_otp=${RUSTODON_BROWSER_OTP:-}
        browser_voter_email=${RUSTODON_BROWSER_VOTER_EMAIL:-}
        browser_voter_password=${RUSTODON_BROWSER_VOTER_PASSWORD:-}
        browser_voter_otp=${RUSTODON_BROWSER_VOTER_OTP:-}
        [ -n "$browser_email" ] || fail 'RUSTODON_BROWSER_EMAIL is required when browser auth is enabled'
        [ -n "$browser_password" ] || fail 'RUSTODON_BROWSER_PASSWORD is required when browser auth is enabled'
        [ -n "$browser_otp" ] || fail 'RUSTODON_BROWSER_OTP is required when browser auth is enabled'
        [ -n "$browser_voter_email" ] || fail 'RUSTODON_BROWSER_VOTER_EMAIL is required when browser auth is enabled'
        [ -n "$browser_voter_password" ] || fail 'RUSTODON_BROWSER_VOTER_PASSWORD is required when browser auth is enabled'
        [ -n "$browser_voter_otp" ] || fail 'RUSTODON_BROWSER_VOTER_OTP is required when browser auth is enabled'
        ;;
    *) fail 'RUSTODON_BROWSER_AUTH must be true or false' ;;
esac
command -v agent-browser >/dev/null 2>&1 || fail 'agent-browser is required'
command -v timeout >/dev/null 2>&1 || fail 'timeout is required for bounded browser observations'

# Fixed labels only: never trace argv, eval source, form values, or cookies.
# Include discovery/launch and cleanup, not just waits; force a stuck child to
# stop five seconds after TERM. A 124 result identifies a bound, not its cause.
cli_step() (
    step_label=$1
    shift
    printf 'browser step: begin %s (limit 20s)\n' "$step_label" >&2
    step_status=0
    timeout --kill-after=5 20 agent-browser "$@" || step_status=$?
    printf 'browser step: end %s (exit %s)\n' "$step_label" "$step_status" >&2
    exit "$step_status"
)

session=$(cli_step session-id session id --scope worktree --prefix rustodon-browser)
# 0.31.1 has no --pin-tab. This single-tab flow exclusively owns a per-run
# session instead of sharing the worktree session's active tab. Cleanup closes
# only this run; concurrent processes in the same worker get distinct names.
session="$session-$$"
browser_args="--host-resolver-rules=MAP $host 127.0.0.1"
if [ -n "$browser_spki" ]; then
    browser_args="$browser_args,--ignore-certificate-errors-spki-list=$browser_spki"
fi
record_path=${RUSTODON_BROWSER_RECORD:-}
recording=false

browser() {
    case "$1" in
        wait)
            case "${2:-}" in
                --load) browser_step=wait-load ;;
                --fn) browser_step=wait-predicate ;;
                *) browser_step=wait ;;
            esac
            ;;
        network|open|eval|get|fill|cookies|pushstate|reload|click|record|screenshot|errors|console|close)
            browser_step=$1 ;;
        *) browser_step=other ;;
    esac
    cli_step "$browser_step" \
        --session "$session" \
        --args "$browser_args" \
        "$@"
}

cleanup() {
    if [ "$recording" = true ]; then
        browser record stop >/dev/null || true
    fi
    browser close >/dev/null || true
    if [ -n "$cookie_jar" ]; then
        rm -f "$cookie_jar"
    fi
    if [ -n "$header_file" ]; then
        rm -f "$header_file"
    fi
    if [ -n "$csrf_body" ]; then
        rm -f "$csrf_body"
    fi
    if [ -n "$init_script" ]; then
        rm -f "$init_script"
    fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

dump_api_diagnostic() {
    if api_diagnostic=$(browser eval "$api_diagnostic_js"); then
        printf 'browser API diagnostic: %s\n' "$api_diagnostic" >&2
    else
        printf '%s\n' 'browser API diagnostic: unavailable' >&2
    fi
}

# Keep every eval gate fail-closed, including malformed CLI output.
assert_js() {
    js_status=0
    js_result=$(browser eval "$2") || js_status=$?
    if [ "$js_status" -eq 0 ] && [ "$js_result" = true ]; then return 0; fi
    # Distinguish a rejected predicate from CLI representation without dumping
    # arbitrary eval output or accepting an unverified JSON envelope.
    case "$js_result" in
        false) result_shape=boolean-false ;;
        '') result_shape=empty ;;
        '"true"'|'"false"') result_shape=quoted-boolean ;;
        '{'*) result_shape=object-like ;;
        *) result_shape=other ;;
    esac
    if [ "$js_status" -ne 0 ]; then result_shape=eval-error; fi
    printf 'browser predicate: %s result=%s\n' "$1" "$result_shape" >&2
    if [ "$1" = api-observer-ready ] || [ "${3:-}" = api ]; then
        dump_api_diagnostic
    elif [ "${3:-}" = settings ]; then
        if settings_diagnostic=$(browser eval "$settings_diagnostic_js"); then
            printf 'browser settings diagnostic: %s\n' "$settings_diagnostic" >&2
        else
            printf '%s\n' 'browser settings diagnostic: unavailable' >&2
        fi
    fi
    [ "$js_status" -eq 0 ] || fail "$1 evaluation failed"
    fail "$1"
}

# Only fixed stages/route labels, flags, counts, and numeric HTTP statuses leave
# the page here. Never return arbitrary paths, queries, IDs, credentials or bodies.
api_diagnostic_js=$(cat <<'JS'
(() => {
  const entries = performance.getEntriesByType('resource');
  const statuses = new Map();
  const failures = new Map();
  // Proven calls from bundled About/UI startup, NavigationPanel, Home, emoji,
  // account-batching, annual-report, push and streaming sources. Include
  // conditional calls too; this vocabulary never permits their HTTP errors.
  const knownPaths = new Set([
    '/api/v2/instance', '/api/v1/instance/extended_description',
    '/api/v1/trends/tags', '/api/v1/custom_emojis',
    '/api/v1/accounts/verify_credentials', '/api/web/settings',
    '/api/v1/markers', '/api/v1/timelines/home', '/api/v2/notifications',
    '/api/v1/instance/translation_languages', '/api/v1/follow_requests',
    '/api/v1/lists', '/api/v1/followed_tags', '/api/v1/announcements',
    '/api/v2/suggestions', '/api/v1/accounts/relationships', '/api/v1/accounts',
    '/api/v2/notifications/policy', '/api/web/push_subscriptions',
    '/api/v1/streaming/', '/api/v1/streaming/user',
  ]);
  const routeLabel = path => {
    if (knownPaths.has(path)) return path;
    if (/^\/api\/v1\/polls\/[^/]+\/votes\/?$/.test(path)) return '/api/v1/polls/:id/votes';
    if (/^\/api\/v1\/polls\/[^/]+\/?$/.test(path)) return '/api/v1/polls/:id';
    if (/^\/api\/v1\/statuses\/[^/]+\/?$/.test(path)) return '/api/v1/statuses/:id';
    if (/^\/api\/v1\/accounts\/[^/]+\/?$/.test(path)) return '/api/v1/accounts/:id';
    if (/^\/api\/v1\/annual_reports\/[^/]+\/state\/?$/.test(path)) return '/api/v1/annual_reports/:year/state';
    if (/^\/api\/v1\/announcements\/[^/]+\/dismiss\/?$/.test(path)) return '/api/v1/announcements/:id/dismiss';
    if (/^\/api\/web\/push_subscriptions\/[^/]+\/?$/.test(path)) return '/api/web/push_subscriptions/:id';
    return '/api/:unclassified';
  };
  let api = 0, crossOrigin = 0;
  const statusCode = value => Number.isInteger(value) && value >= 0 && value <= 599 ? value : -1;
  for (const entry of entries) {
    const url = new URL(entry.name, location.href);
    if (!url.pathname.startsWith('/api/')) continue;
    api++;
    const foreign = url.origin !== location.origin;
    if (foreign) crossOrigin++;
    const status = statusCode(entry.responseStatus);
    statuses.set(status, (statuses.get(status) || 0) + 1);
    if (foreign || status < 200 || status >= 300) {
      const route = routeLabel(url.pathname);
      const key = JSON.stringify([route, status, foreign]);
      const failure = failures.get(key) || { route, status, crossOrigin: foreign, count: 0 };
      failure.count++;
      failures.set(key, failure);
    }
  }
  const probe = window.__rustodonApiProbe || {};
  const watch = window.__rustodonApiSmoke;
  const stages = ['startup-audit', 'auth-probe', 'missing-probe', 'timing-entries', 'complete'];
  return JSON.stringify({
    stage: stages.includes(probe.stage) ? probe.stage : 'unavailable',
    readyState: ['loading', 'interactive', 'complete'].includes(document.readyState) ? document.readyState : 'unknown',
    mountPresent: Boolean(document.querySelector('#mastodon')),
    reactPresent: Boolean(document.querySelector('#mastodon > :not(noscript)')),
    observerInstalled: Boolean(watch),
    pending: Number.isInteger(watch?.pending) && watch.pending >= 0 ? watch.pending : null,
    transportFailed: watch?.failed === true,
    probeStatuses: Array.isArray(probe.statuses) ? probe.statuses.slice(0, 2).map(statusCode) : [],
    responseStatusSupported: 'responseStatus' in PerformanceResourceTiming.prototype,
    resources: entries.length, bufferMayBeFull: entries.length >= 250, api, crossOrigin,
    statuses: [...statuses].sort((a, b) => a[0] - b[0]).slice(0, 12), distinctStatuses: statuses.size,
    failedRoutes: [...failures.values()].slice(0, 12), distinctFailedRoutes: failures.size,
  });
})()
JS
)

# Resource Timing is buffered from document start, unlike an XHR hook installed
# after React mounts. Audit recorded completed responses before each full
# navigation. No CLI network-response schema is assumed.
api_audit_js=$(cat <<'JS'
(() => {
  const entries = performance.getEntriesByType('resource');
  if (!('responseStatus' in PerformanceResourceTiming.prototype) || entries.length >= 250) return false;
  const expected = new Map([
    ['/api/v1/accounts/verify_credentials?rustodon_smoke=auth', 401],
    ['/api/v1/statuses/999999999999999999?rustodon_smoke=missing', 404],
  ]);
  return entries.every(entry => {
    const url = new URL(entry.name, location.href);
    if (!url.pathname.startsWith('/api/')) return true;
    if (url.origin !== location.origin) return false;
    const deliberate = expected.get(url.pathname + url.search);
    return deliberate !== undefined
      ? entry.initiatorType === 'fetch' && entry.responseStatus === deliberate
      : Number.isInteger(entry.responseStatus) && entry.responseStatus >= 200 && entry.responseStatus < 300;
  });
})()
JS
)

# Register once before navigation using the verified 0.31.1 --init-script flag.
# The per-document guard also prevents accidental re-execution from resetting
# in-flight counters. Audits only read this observer; they never install it late.
# Tracks fetch/XHR bodies, not WebSocket/EventSource health; a streaming fetch
# that never completes will fail the bounded drain rather than be exempted.
api_watch_js=$(cat <<'JS'
if (!window.__rustodonApiSmoke) {
  const watch = window.__rustodonApiSmoke = { pending: 0, failed: false, changed: performance.now() };
  const isApi = url => new URL(url, location.href).pathname.startsWith('/api/');
  const begin = () => { watch.pending++; watch.changed = performance.now(); };
  const end = failed => { watch.pending--; watch.failed ||= failed; watch.changed = performance.now(); };
  const originalFetch = window.fetch;
  window.fetch = function(input, ...args) {
    if (!isApi(typeof input === 'string' || input instanceof URL ? input : input.url)) {
      return originalFetch.call(this, input, ...args);
    }
    begin();
    try {
      return originalFetch.call(this, input, ...args).then(response => {
        response.clone().arrayBuffer().then(() => end(response.redirected), () => end(true));
        return response;
      }, error => { end(true); throw error; });
    } catch (error) { end(true); throw error; }
  };
  const originalOpen = XMLHttpRequest.prototype.open;
  const originalSend = XMLHttpRequest.prototype.send;
  const tracked = new WeakSet();
  XMLHttpRequest.prototype.open = function(method, url, ...args) {
    if (isApi(url)) tracked.add(this); else tracked.delete(this);
    return originalOpen.call(this, method, url, ...args);
  };
  XMLHttpRequest.prototype.send = function(...args) {
    if (!tracked.has(this)) return originalSend.apply(this, args);
    begin();
    let ended = false;
    const finish = failed => { if (!ended) { ended = true; end(failed); } };
    this.addEventListener('loadend', () => finish(this.status === 0), { once: true });
    try { return originalSend.apply(this, args); }
    catch (error) { finish(true); throw error; }
  };
}
JS
)

api_drain_js=$(cat <<'JS'
const watch = window.__rustodonApiSmoke;
if (!watch) return false;
const deadline = performance.now() + 8000;
let count = performance.getEntriesByType('resource').length;
let quiet = performance.now();
while (performance.now() < deadline) {
  if (watch.failed) return false;
  const current = performance.getEntriesByType('resource').length;
  if (current !== count) { count = current; quiet = performance.now(); }
  if (watch.pending === 0 && performance.now() - Math.max(quiet, watch.changed) >= 500) return true;
  await new Promise(resolve => setTimeout(resolve, 25));
}
return false;
JS
)

audit_api() {
    assert_js "${1:-unexpected or unobservable API response}" "${2:-}
(async () => {
  if (!(await (async () => { $api_drain_js })())) return false;
  return $api_audit_js;
})()" api
}

# Installed core documents --fn and --init-script, but not networkidle's
# internal algorithm. Use application readiness, not a claimed timeout cause.
app_ready_js="Boolean(document.querySelector('#mastodon > :not(noscript)'))"
wait_ready() {
    printf 'browser readiness: %s\n' "$1" >&2
    if browser wait --fn "/* rustodon-ready: $1 */ Boolean(window.__rustodonApiSmoke && document.readyState !== 'loading' && ($2))" >/dev/null; then
        return 0
    fi
    dump_api_diagnostic
    fail "$1 readiness failed"
}

# mktemp creates an exclusive file; restrictive creation applies even with a
# permissive caller umask. No credentials or instance data go into this file.
init_script=$(umask 077; mktemp "${TMPDIR:-/tmp}/rustodon-browser-init.XXXXXX")
printf '(() => {\n%s\n})();\n' "$api_watch_js" > "$init_script"
# This is the only registration. No URL: remain on about:blank while staging.
# Closing the owned session discards the registration, even on early failure.
browser open --init-script "$init_script" >/dev/null
if [ -n "$record_path" ]; then
    command -v ffmpeg >/dev/null 2>&1 || fail 'ffmpeg is required when RUSTODON_BROWSER_RECORD is set'
    mkdir -p "$(dirname "$record_path")"
    browser record start "$record_path" >/dev/null
    recording=true
fi
browser network requests --clear >/dev/null
browser open "$base_url/" >/dev/null
wait_ready initial-app "$app_ready_js"
# These are deliberate read-only failures with unique URLs, not exemptions for
# frontend failures on the same paths. Abort each probe after five seconds.
assert_js 'api-observer-ready' "/* rustodon-smoke: api-observer-ready */
(async () => {
  const progress = window.__rustodonApiProbe = { stage: 'startup-audit', statuses: [] };
  if (!(await (async () => { $api_drain_js })())) return false;
  if (!($api_audit_js)) return false;
  const probes = [
    ['/api/v1/accounts/verify_credentials?rustodon_smoke=auth', 401],
    ['/api/v1/statuses/999999999999999999?rustodon_smoke=missing', 404],
  ];
  for (const [index, [path, status]] of probes.entries()) {
    progress.stage = index === 0 ? 'auth-probe' : 'missing-probe';
    const response = await fetch(path, { credentials: 'omit', cache: 'no-store', signal: AbortSignal.timeout(5000) });
    await response.arrayBuffer();
    progress.statuses.push(response.status);
    if (response.status !== status) return false;
  }
  progress.stage = 'timing-entries';
  const deadline = performance.now() + 1000;
  while (performance.now() < deadline) {
    const entries = performance.getEntriesByType('resource');
    if (probes.every(([path, status]) => entries.some(entry =>
      entry.name === new URL(path, location.href).href && entry.initiatorType === 'fetch' && entry.responseStatus === status))) {
      progress.stage = 'complete';
      return true;
    }
    await new Promise(resolve => setTimeout(resolve, 25));
  }
  return false;
})()"
audit_api

debug_dump() {
    if [ "${RUSTODON_BROWSER_DEBUG:-false}" = true ]; then
        printf 'browser scripts: '
        browser eval 'JSON.stringify([...document.scripts].map(script => ({src: script.src, type: script.type})))'
        printf 'browser packs: %s\n' "$(browser network requests --filter '/packs/')"
        printf 'browser errors: %s\n' "$(browser errors)"
        printf 'browser console: %s\n' "$(browser console)"
    fi
}

assert_mount() {
    mount_count=$(browser get count '#mastodon' | tr -d '\r\n')
    [ "$mount_count" = 1 ] || fail "expected one #mastodon mount, got $mount_count"
    mount_ready=$(browser eval "Boolean(document.querySelector('#mastodon > :not(noscript)'))")
    case "$mount_ready" in
        true) ;;
        *)
            debug_dump
            fail 'Mastodon React mount did not replace the JavaScript fallback'
            ;;
    esac
    mount_text=$(browser get text '#mastodon')
    case "$mount_text" in
        '')
            debug_dump
            fail 'Mastodon React mount rendered no visible content'
            ;;
    esac
}

# Keep hostname verification enabled and ignore ambient .curlrc options. The
# fixture CA is scoped to these calls, never installed into a shared trust store.
# Invalid PEM/trust/hostname errors propagate; there is no insecure fallback.
fixture_curl() {
    if [ -n "$browser_ca" ]; then
        curl --disable --cacert "$browser_ca" "$@"
    else
        curl --disable "$@"
    fi
}

bootstrap_csrf() {
    csrf_path=$1
    bootstrap_cookie=$2
    csrf_label=$3
    fixture_curl --silent --show-error --fail --max-time 30 \
        --resolve "$base_host:$base_port:127.0.0.1" \
        --header "Host: $host" \
        --header 'X-Forwarded-Proto: https' \
        --cookie "$bootstrap_cookie" \
        --dump-header "$header_file" \
        --output "$csrf_body" \
        "$base_url$csrf_path" || fail "$csrf_label CSRF bootstrap failed"
    csrf_token=$(awk 'match($0, /name="csrf_token"[[:space:]]+value="[^"]+"/) { value = substr($0, RSTART, RLENGTH); sub(/^.*value="/, "", value); sub(/"$/, "", value); print value; exit }' "$csrf_body")
    csrf_cookie=$(awk 'tolower($0) ~ /^set-cookie:[[:space:]]*__host-csrf_token=/ { line = $0; sub(/^[^:]+:[[:space:]]*/, "", line); sub(/^[^=]+=/, "", line); sub(/;.*/, "", line); print line; exit }' "$header_file")
    [ -n "$csrf_token" ] || fail "$csrf_label page did not expose a CSRF token"
    [ -n "$csrf_cookie" ] || fail "$csrf_label did not return an __Host-csrf_token cookie"
}

# Only the disposable fixture's Home controls are changed. These helpers never
# import Redux internals, dispatch fabricated actions, or write settings via HTTP.
open_home_settings() {
    browser pushstate "$base_url/home" >/dev/null
    wait_ready home-controls "location.pathname === '/home' && Boolean(document.querySelector('button.column-header__button[aria-label=\"Show settings\"]'))"
    browser click 'button.column-header__button[aria-label="Show settings"]' >/dev/null
}

# Diagnostic projection only: never serialize request bodies, bootstrap, Redux
# state, resource URLs, IDs, or arbitrary field values. Earlier HTTP activity is
# evidence of earlier requests, not proof of the shared debounce's internal state.
settings_diagnostic_js=$(cat <<'JS'
(() => {
  const state = window.__rustodonSettingsSmoke;
  const list = value => Array.isArray(value) ? value : [];
  const boolean = value => typeof value === 'boolean' ? value : null;
  const delta = (end, start) => Number.isFinite(end) && Number.isFinite(start) ? Math.round(end - start) : null;
  const status = value => Number.isInteger(value) && value >= 0 && value <= 599 ? value : null;
  const initial = [0, 1].map(index => boolean(state?.initial?.[index]));
  const target = [0, 1].map(index => boolean(state?.target?.[index]));
  const changes = list(state?.changes);
  const requests = list(state?.requests);
  const firstClick = changes[0]?.at;
  const now = performance.now();
  const resources = performance.getEntriesByType('resource').filter(entry =>
    new URL(entry.name, location.href).pathname === '/api/web/settings');
  return JSON.stringify({
    statePresent: Boolean(state), initial, target,
    browserHttps: new URL(location.href).protocol === 'https:',
    pendingApi: Number.isInteger(window.__rustodonApiSmoke?.pending) && window.__rustodonApiSmoke.pending >= 0 ? window.__rustodonApiSmoke.pending : null,
    checkbox: ['reblog', 'reply'].map(key => {
      const controls = document.querySelectorAll('#setting-toggle-home_timeline-shows-' + key);
      return { count: controls.length, checked: controls.length === 1 ? boolean(controls[0].checked) : null };
    }),
    settlingMs: delta(state?.armedAt, state?.setupStartedAt),
    firstClickAgeMs: delta(now, firstClick),
    leadingDeadlineAfterClickMs: delta(state?.leadingDeadline, firstClick),
    trailingDeadlineAfterClickMs: delta(state?.trailingDeadline, firstClick),
    changeCount: changes.length,
    changes: changes.slice(0, 4).map(change => ({
      index: change.index === 0 || change.index === 1 ? change.index : -1,
      checked: boolean(change.checked), afterArmingMs: delta(change.at, state?.armedAt),
    })),
    requestCount: requests.length,
    // Preserve the first/leading candidate even if unrelated activity overflows
    // the bounded projection. requestCount still exposes the full count.
    requests: requests.slice(0, 8).map(request => {
      const data = request.body?.data;
