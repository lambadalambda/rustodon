#!/bin/sh
# Explicit, bounded required lane; broader coverage is opt-in.
set -eu

ROOT=$(CDPATH= cd -P -- "$(dirname -- "$0")/.." && pwd)
[ "$#" -le 1 ] || { echo 'Usage: tools/ci-differential [required|full]' >&2; exit 2; }
case "${1:-required}" in
  required|full) lane=${1:-required} ;;
  *) echo 'Usage: tools/ci-differential [required|full]' >&2; exit 2 ;;
esac
cd "$ROOT"
# Always exercise both media-root representations, independent of caller env.
unset RUSTODON_DIFFERENTIAL_ACTOR_MEDIA_ROOT
if [ "$lane" = full ]; then
  "$ROOT/tools/mastodon-fixture" differential-test
else
  for case_name in \
    oauth_bearer_authentication core_rest_serializers rest_protocol_contracts \
    federation_discovery status_authorization_matrix \
    authorized_fetch_read_routes_require_signatures \
    browser_recovery_fences browser_reauthentication_limits actor_media_root_url
  do
    "$ROOT/tools/mastodon-fixture" differential-test "$case_name"
  done
fi
RUSTODON_DIFFERENTIAL_ACTOR_MEDIA_ROOT=relative \
  "$ROOT/tools/mastodon-fixture" differential-test actor_media_root_url
